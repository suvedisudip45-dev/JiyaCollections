# Admin Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env — it is already in .gitignore

# ─── Backend API URL ────────────────────────────────────────
# Local dev: http://localhost:4000
# Production (Netlify): your Railway backend URL
VITE_BACKEND_URL=https://your-backend.railway.app

# NCM webhook shared secret used by the Delivery Monitor simulator.
# VITE_ values are included in the browser bundle; use only for a protected admin deployment.
VITE_NCM_WEBHOOK_BASE_URL=your_webhook_base_url_here
VITE_NCM_WEBHOOK_SECRET=your_ncm_webhook_secret_here

# ─── Encryption ─────────────────────────────────────────────
# Must match the AES_SECRET_KEY on the backend
VITE_AES_KEY=your_aes_secret_key_here
VITE_AES_IV=your_aes_iv_hex_here
