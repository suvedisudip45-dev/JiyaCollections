# Marketing Partner Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env — it is already in .gitignore

# ─── Backend API URL ────────────────────────────────────────
VITE_BACKEND_URL=https://your-backend.railway.app

# ─── HMAC request signing compatibility ─────────────────────
# Must match backend HMAC_SECRET. VITE_ values are public in the browser bundle.
VITE_HMAC_SECRET=replace_with_a_shared_hmac_secret

# ─── Encryption ─────────────────────────────────────────────
VITE_AES_KEY=your_aes_secret_key_here
VITE_AES_IV=your_aes_iv_hex_here
