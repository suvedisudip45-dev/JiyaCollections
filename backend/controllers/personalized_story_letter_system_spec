Use one authoritative table for the lifecycle of a letter allocated to an order.

Recommended name:

```text
letter_deliveries
```

Schema:

```sql
CREATE TABLE letter_deliveries (
    id                      BIGINT PRIMARY KEY,

    customer_id             BIGINT NOT NULL,
    order_id                BIGINT NOT NULL,
    manufacturer_id         BIGINT NULL,

    customer_story_assignment_id BIGINT NOT NULL,
    story_id                BIGINT NOT NULL,
    story_letter_id         BIGINT NOT NULL,

    template_id             BIGINT NOT NULL,
    template_version_id     BIGINT NOT NULL,

    status                  VARCHAR(30) NOT NULL,

    reserved_at             TIMESTAMP NULL,
    printed_at              TIMESTAMP NULL,
    packed_at               TIMESTAMP NULL,
    shipped_at              TIMESTAMP NULL,
    delivered_at            TIMESTAMP NULL,
    cancelled_at            TIMESTAMP NULL,

    rendered_content        TEXT NULL,
    rendered_html           TEXT NULL,
    rendered_document_url   TEXT NULL,

    created_at              TIMESTAMP NOT NULL,
    updated_at              TIMESTAMP NOT NULL,

    FOREIGN KEY (customer_id) REFERENCES customers(id),
    FOREIGN KEY (order_id) REFERENCES orders(id),
    FOREIGN KEY (story_id) REFERENCES stories(id),
