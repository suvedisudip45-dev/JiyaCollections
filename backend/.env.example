# Backend Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file — it is already in .gitignore

# ─── Database ───────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED"

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
AES_SECRET_KEY=your_aes_secret_key_here

# ─── Cloudinary (Image Uploads) ─────────────────────────────
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret_key

# ─── Payment Gateways ───────────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── Admin ──────────────────────────────────────────────────
ADMIN_SEED_PASSWORD=Admin@1234

# ─── CORS — Set these to your accepted origins ─────────────
# Comma-separated list of allowed frontend/admin URLs.
# You may also set a single ACCEPTED_URL and/or a broader CORS_ALLOWED_ORIGINS list.
# Example: https://aama-clothings.netlify.app,https://admin.aama-clothings.netlify.app
CORS_ALLOWED_ORIGINS=https://your-frontend.netlify.app,https://your-admin.netlify.app,https://your-manufacturer.netlify.app
ACCEPTED_URL=https://your-accepted-url.netlify.app
FRONTEND_URL=https://your-frontend.netlify.app
ADMIN_URL=https://your-admin.netlify.app
MANUFACTURER_URL=https://your-manufacturer.netlify.app

# ─── Nepal Can Move Delivery Integration ────────────────────
NCM_API_BASE_URL=https://demo.nepalcanmove.com
NCM_API_TOKEN=replace_with_server_side_token
NCM_WEBHOOK_SECRET=replace_with_long_random_webhook_secret
# JSON object mapping local city keys to exact NCM branch names and priority order.
# Each key can map to a single branch name or an array of prioritized branch names.
NCM_BRANCH_MAP_JSON={"kathmandu":["TINKUNE","LALITPUR","KATHMANDU"],"lalitpur":["LALITPUR","TINKUNE","KATHMANDU"],"patan":["LALITPUR","TINKUNE","KATHMANDU"],"bhaktapur":["BHAKTAPUR","TINKUNE","KATHMANDU"],"pokhara":["POKHARA","BHAKTAPUR"],"baglung":["BAGLUNG","POKHARA"],"lamjung":["LAMJUNG","POKHARA"],"besisahar":["LAMJUNG","POKHARA"],"biratnagar":["BIRATNAGAR","DHARAN"],"dharan":["DHARAN","BIRATNAGAR"],"itahari":["DHARAN","BIRATNAGAR"],"butwal":["BUTWAL","BHARATPUR"],"bharatpur":["BHARATPUR","BUTWAL"],"chitwan":["BHARATPUR","BUTWAL"],"hetauda":["HETAUDA","BHAKTAPUR"],"birgunj":["BIRGUNJ","HETAUDA"],"janakpur":["JANAKPUR"],"nepalgunj":["NEPALGUNJ","BUTWAL"],"dhangadhi":["DHANGADHI"],"surkhet":["SURKHET","NEPALGUNJ"],"birendranagar":["SURKHET","NEPALGUNJ"],"bhairahawa":["BHAIRAHAWA","BUTWAL"],"siddharthanagar":["BHAIRAHAWA","BUTWAL"],"illam":["ILLAM"],"gorkha":["GORKHA","POKHARA"],"dang":["DANG","NEPALGUNJ"],"jumla":["JUMLA","DHANGADHI"],"lahan":["LAHAN","BIRATNAGAR"]}

# ─── Server ─────────────────────────────────────────────────
# Railway sets PORT automatically — do not set this manually on Railway
PORT=4000
