{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "node scripts/runTestsSequentially.js",
    "test:accounting": "node tests/accountingEngine.test.js",
    "test:delivery": "node --test tests/deliveryAutomation.test.js",
    "test:notifications": "node --test tests/notification*.test.js",
    "rabbitmq:check": "node scripts/checkNotificationBroker.js",
    "notifications:health": "node scripts/checkNotificationHealth.js",
    "ops:exceptions": "node scripts/reportOperationalExceptions.js",
    "delivery:ncm-reconcile": "node scripts/reconcileNcmDeliveries.js",
    "check:migrations": "node scripts/checkMigrationFiles.js",
    "worker:notifications": "node notificationWorker.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "prisma generate",
    "db:migrate:deploy": "node scripts/assertDatabaseToolTarget.js migration && prisma migrate deploy",
    "db:migrate:test": "node scripts/assertDatabaseToolTarget.js testMigration && prisma migrate deploy",
    "db:push": "node scripts/assertDatabaseToolTarget.js migration maintenance && prisma db push && prisma db seed",
    "db:sync": "node scripts/assertDatabaseToolTarget.js migration && prisma migrate dev",
    "db:seed": "node scripts/assertDatabaseToolTarget.js maintenance && prisma db seed",
    "db:reset": "node scripts/assertDatabaseToolTarget.js migration && prisma migrate reset --force",
    "seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.3",
    "nepali-date-converter": "^3.4.0",
    "nodemailer": "^10.0.10",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}
