generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AuthAccount {
  id           String  @id @default(uuid())
  email        String  @unique @db.VarChar(255)
  phone        String? @unique @db.VarChar(32)
  passwordHash String  @db.VarChar(255)
  role         String  @default("CUSTOMER") // Legacy primary role; active workspace grants are stored in AuthAccountRoleMapping.
  status       String  @default("ACTIVE") // ACTIVE | PENDING_APPROVAL | SUSPENDED | REJECTED | INACTIVE

  failedLoginAttempts Int       @default(0)
  accountLockedUntil  DateTime?
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?   @db.VarChar(64)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  mustChangePassword Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfile         User?
  adminProfile            Admin?
  manufacturerProfile     Manufacturer?
  distributorProfile      Distributor?
  marketingPartnerProfile MarketingPartner?

  otpChallenges OtpChallenge[]
  adminTwoFactorChallenges AdminTwoFactorChallenge[]
  auditLogs     AuthAuditLog[]
  sessions      AuthSession[]
  roleMappings  AuthAccountRoleMapping[]
  accessManagementEvents  AccessManagementAuditLog[] @relation("AccessManagementActor")
  accessManagementTargets AccessManagementAuditLog[] @relation("AccessManagementTarget")

  @@index([email])
  @@index([phone])
  @@index([role, status])
}

model Role {
  id          String                   @id @default(uuid())
  code        String                   @unique @db.VarChar(64)
  name        String                   @db.VarChar(120)
  description String?                  @db.Text
  portalScope String                   @default("ADMIN") @db.VarChar(32)
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  permissions RolePermissionMapping[]
  accounts    AuthAccountRoleMapping[]

  @@index([isActive])
}

model Permission {
  id          String                  @id @default(uuid())
  code        String                  @unique @db.VarChar(120)
  description String?                 @db.Text
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  roles       RolePermissionMapping[]

  @@index([isActive])
}

model RolePermissionMapping {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model AuthAccountRoleMapping {
  id        String      @id @default(uuid())
  accountId String
  roleId    String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  account   AuthAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([accountId, roleId])
  @@index([accountId, isActive])
  @@index([roleId, isActive])
}

model AuthSession {
  id               String    @id @default(uuid())
  accountId        String
  tokenFamilyId    String    @db.VarChar(64)
  jti              String    @unique @db.VarChar(128)
  tokenType        String    @default("ACCESS") // ACCESS | REFRESH
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedByTokenId String?  @db.VarChar(128)
  lastUsedAt       DateTime?
  createdIp        String?   @db.VarChar(64)
  lastUsedIp       String?   @db.VarChar(64)
  userAgent        String?   @db.Text
  revocationReason String?   @db.VarChar(255)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  account AuthAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, tokenType, revokedAt])
  @@index([tokenFamilyId])
  @@index([expiresAt])
}

model OtpChallenge {
  id            String    @id @default(uuid())
  accountId     String?
  destination   String    @db.VarChar(255)
  channel       String    @default("SMS") // SMS | EMAIL
  purpose       String    @default("LOGIN") // LOGIN | SIGNUP | PASSWORD_RESET | CHANGE_PHONE
  codeHash      String    @db.VarChar(255)
  expiresAt     DateTime
  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(5)
  lastSentAt    DateTime  @default(now())
  verifiedAt    DateTime?
  isInvalidated Boolean   @default(false)
  createdAt     DateTime  @default(now())

  account AuthAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([destination, purpose, isInvalidated])
  @@index([expiresAt])
}

model AdminTwoFactorChallenge {
  id             String    @id @default(uuid()) @db.VarChar(191)
  accountId      String    @db.VarChar(191)
  targetPortal   String    @default("ADMIN") @db.VarChar(32)
  purpose        String    @default("ADMIN_LOGIN") @db.VarChar(32)
  method         String?   @db.VarChar(16)
  otpHash        String?   @db.VarChar(64)
  status         String    @default("PENDING") @db.VarChar(16)
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(5)
  resendCount    Int       @default(0)
  expiresAt      DateTime
  lastSentAt     DateTime?
  verifiedAt     DateTime?
  consumedAt     DateTime?
  notificationId String?   @unique @db.VarChar(191)
  requestIp      String?   @db.VarChar(64)
  userAgentHash  String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account      AuthAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([accountId, status, createdAt])
  @@index([status, expiresAt])
}

model AuthAuditLog {
  id            String   @id @default(uuid())
  accountId     String?
  identifier    String   @db.VarChar(255)
  action        String
  role          String?
  portal        String?
  ipAddress     String?  @db.VarChar(64)
  userAgent     String?  @db.Text
  status        String
  failureReason String?  @db.VarChar(255)
  metadata      Json?    @default("{}")
  createdAt     DateTime @default(now())

  account AuthAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([identifier, createdAt])
  @@index([action, createdAt])
  @@index([accountId])
}

model AccessManagementAuditLog {
  id             String       @id @default(uuid())
  actorAccountId String?
  targetAccountId String?
  action         String       @db.VarChar(80)
  metadata       Json?
  createdAt      DateTime     @default(now())
  actor          AuthAccount? @relation("AccessManagementActor", fields: [actorAccountId], references: [id], onDelete: SetNull)
  target         AuthAccount? @relation("AccessManagementTarget", fields: [targetAccountId], references: [id], onDelete: SetNull)

  @@index([actorAccountId, createdAt])
  @@index([targetAccountId, createdAt])
  @@index([action, createdAt])
}

model SystemAuditLog {
  id             String   @id @default(uuid())
  outboxId       String?  @unique @db.VarChar(36)
  actorId        String?  @db.VarChar(191)
  actorRole      String?  @db.VarChar(32)
  action         String   @db.VarChar(120)
  entityType     String   @db.VarChar(80)
  entityId       String?  @db.VarChar(191)
  beforeState    Json?
  afterState     Json?
  portalSource   String?  @db.VarChar(32)
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?  @db.Text
  status         String   @default("SUCCESS") @db.VarChar(24)
  failureReason  String?  @db.VarChar(255)
  correlationId  String?  @db.VarChar(128)
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([correlationId])
}

model SystemAuditOutbox {
  id          String    @id @default(uuid()) @db.VarChar(36)
  event       Json
  status      String    @default("PENDING") @db.VarChar(16)
  attemptCount Int      @default(0)
  availableAt DateTime  @default(now())
  claimedAt   DateTime?
  processedAt DateTime?
  lastError   String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now())

  @@index([status, availableAt, createdAt])
  @@index([claimedAt])
}

model Notification {
  id                 String   @id @default(uuid())
  idempotencyKey     String?  @unique @db.VarChar(191)
  notificationType   String   @default("GENERAL") @db.VarChar(64)
  channel             String   @db.VarChar(16)
  status              String   @default("PENDING") @db.VarChar(32)
  recipientName       String?  @db.VarChar(160)
  recipientAddress    String   @db.VarChar(255)
  subject             String?  @db.VarChar(255)
  template            String?  @db.VarChar(120)
  payload             Json?
  provider            String?  @db.VarChar(64)
  providerMessageId   String?  @db.VarChar(191)
  priority            Int      @default(0)
  attemptCount        Int      @default(0)
  maxAttempts         Int      @default(5)
  nextRetryAt         DateTime?
  lastAttemptAt       DateTime?
  queuedAt            DateTime?
  acceptedAt          DateTime?
  deliveredAt         DateTime?
  failedAt            DateTime?
  failureCode         String?  @db.VarChar(120)
  failureReason       String?  @db.Text
  claimToken          String?  @db.VarChar(64)
  claimExpiresAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  attempts NotificationAttempt[]
  events   NotificationEvent[]
  outbox   NotificationOutbox[]
  adminTwoFactorChallenge AdminTwoFactorChallenge?

  @@index([status, nextRetryAt])
  @@index([channel, status, createdAt])
  @@index([provider, providerMessageId])
  @@index([status, claimExpiresAt])
}

model NotificationAttempt {
  id                    String    @id @default(uuid())
  notificationId        String
  attemptNumber         Int
  status                String    @db.VarChar(32)
  provider              String?   @db.VarChar(64)
  providerMessageId     String?   @db.VarChar(191)
  requestStartedAt      DateTime  @default(now())
  requestFinishedAt     DateTime?
  httpStatus            Int?
  providerStatus        String?   @db.VarChar(120)
  providerErrorCode     String?   @db.VarChar(120)
  providerErrorMessage  String?   @db.Text
  failureCategory       String?   @db.VarChar(40)
  createdAt             DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, attemptNumber])
  @@index([status, createdAt])
  @@index([provider, providerMessageId])
}

model NotificationEvent {
  id                String   @id @default(uuid())
  notificationId    String
  eventType         String   @db.VarChar(64)
  provider          String?  @db.VarChar(64)
  providerEventId   String?  @db.VarChar(191)
  providerMessageId String?  @db.VarChar(191)
  eventTimestamp    DateTime @default(now())
  payloadHash       String?  @db.VarChar(128)
  createdAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([notificationId, eventTimestamp])
  @@index([provider, providerMessageId])
}

model NotificationOutbox {
  id              String    @id @default(uuid())
  notificationId  String
  eventKey        String    @unique @db.VarChar(191)
  routingKey      String    @db.VarChar(80)
  payload         Json
  attemptCount    Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  leaseToken      String?   @db.VarChar(64)
  leaseExpiresAt  DateTime?
  publishedAt     DateTime?
  lastError       String?   @db.Text
  createdAt       DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([publishedAt, nextAttemptAt, leaseExpiresAt])
}

model IncomingSms {
  id                String    @id @default(uuid())
  provider          String    @default("SPARROW") @db.VarChar(64)
  providerMessageId String?   @db.VarChar(191)
  fromNumber        String    @db.VarChar(64)
  toShortCode       String    @db.VarChar(64)
  keyword           String?   @db.VarChar(64)
  text              String    @db.VarChar(1600)
  payloadHash       String    @db.VarChar(128)
  receivedAt        DateTime  @default(now())
  processingStatus  String    @default("RECEIVED") @db.VarChar(32)
  processedAt       DateTime?
  replyText         String?   @db.VarChar(160)
  replyStatus       String?   @db.VarChar(32)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, providerMessageId])
  @@index([provider, payloadHash, receivedAt])
  @@index([processingStatus, receivedAt])
}

model User {
  id                  String       @id @default(uuid())
  accountId           String?      @unique
  account             AuthAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  firstName           String?      @default("")
  lastName            String?      @default("")
  phone               String?      @default("")
  gender              String?      @default("PREFER_NOT_TO_SAY") // MALE | FEMALE | OTHER | PREFER_NOT_TO_SAY
  name                String
  email               String       @unique
  password            String?      @default("")
  socialCustomerCode  String?      @unique
  socialCustomerPhone String?      @default("")
  loyaltyTier         String?      @default("")
  isInactiveProfile   Boolean      @default(false)
  inactiveProfileData Json         @default("{}")
  cartData            Json         @default("{}")
  addresses           Json         @default("[]")

  storyAssignments            CustomerStoryAssignment[]    @relation("CustomerStoryAssignmentCustomer")
  letterDeliveries            LetterDelivery[]             @relation("CustomerLetterDeliveryCustomer")
  marketingCardLinks          MarketingCardCustomer[]      @relation("MarketingCardCustomerUser")
  marketingBenefitRedemptions MarketingBenefitRedemption[]
  orderExchangeRequests       OrderExchangeRequest[]
  distributorReviews          DistributorReview[]
}

model Story {
  id                   String                    @id @default(uuid())
  title                String
  description          String?                   @db.Text
  status               String                    @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED
  assignmentEnabled    Boolean                   @default(true)
  allowNewCustomers    Boolean                   @default(true)
  allowAfterCompletion Boolean                   @default(true)
  assignmentWeight     Float                     @default(1)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  letters              StoryLetter[]
  assignments          CustomerStoryAssignment[]
  deliveries           LetterDelivery[]

  @@index([status, assignmentEnabled])
}

model StoryLetter {
  id                String           @id @default(uuid())
  storyId           String
  sequenceNumber    Int
  title             String
  summary           String?          @db.Text
  continuitySummary String?          @db.Text
  content           String           @db.Text
  status            String           @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  story             Story            @relation(fields: [storyId], references: [id], onDelete: Cascade)
  deliveries        LetterDelivery[]

  @@unique([storyId, sequenceNumber])
  @@index([storyId, sequenceNumber])
}

model LetterTemplate {
  id               String                  @id @default(uuid())
  name             String
  description      String?                 @db.Text
  status           String                  @default("ACTIVE") // ACTIVE | DRAFT | PAUSED | ARCHIVED
  targetGender     String                  @default("ANY") // ANY | MALE | FEMALE | OTHER | PREFER_NOT_TO_SAY
  selectionWeight  Float                   @default(1)
  repetitionWindow Int?                    @default(3)
  body             String                  @db.Text
  createdBy        String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  versions         LetterTemplateVersion[]
  deliveries       LetterDelivery[]

  @@index([status])
  @@index([targetGender, status])
}

model LetterTemplateVersion {
  id            String           @id @default(uuid())
  templateId    String
  versionNumber Int
  body          String           @db.Text
  createdBy     String?
  createdAt     DateTime         @default(now())
  template      LetterTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  deliveries    LetterDelivery[]

  @@unique([templateId, versionNumber])
  @@index([templateId])
}

model CustomerStoryAssignment {
  id                 String           @id @default(uuid())
  customerId         String
  storyId            String
  status             String           @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  nextSequenceNumber Int              @default(1)
  startedAt          DateTime         @default(now())
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  customer           User             @relation("CustomerStoryAssignmentCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  story              Story            @relation(fields: [storyId], references: [id], onDelete: Cascade)
  deliveries         LetterDelivery[] @relation("AssignmentLetterDelivery")

  @@index([customerId, status])
  @@index([storyId, status])
}

model LetterDelivery {
  id                        String                  @id @default(uuid())
  customerId                String
  orderId                   String                  @unique
  manufacturerId            String?
  customerStoryAssignmentId String
  storyId                   String
  storyLetterId             String
  templateId                String
  templateVersionId         String
  idempotencyKey            String?                 @unique
  status                    String                  @default("RESERVED") // RESERVED | PRINTED | PACKED | SHIPPED | DELIVERED | CANCELLED | VOIDED
  reservedAt                DateTime?
  printedAt                 DateTime?
  packedAt                  DateTime?
  shippedAt                 DateTime?
  deliveredAt               DateTime?
  cancelledAt               DateTime?
  renderedContent           String?                 @db.Text
  renderedHtml              String?                 @db.Text
  renderedDocumentUrl       String?                 @db.Text
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  customer                  User                    @relation("CustomerLetterDeliveryCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  order                     Order                   @relation("OrderLetterDelivery", fields: [orderId], references: [id], onDelete: Cascade)
  assignment                CustomerStoryAssignment @relation("AssignmentLetterDelivery", fields: [customerStoryAssignmentId], references: [id], onDelete: Cascade)
  story                     Story                   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storyLetter               StoryLetter             @relation(fields: [storyLetterId], references: [id], onDelete: Restrict)
  template                  LetterTemplate          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion           LetterTemplateVersion   @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([storyId, createdAt])
  @@index([status])
}

model Product {
  id                String    @id @default(uuid())
  name              String
  nepaliName        String?   @default("")
  description       String    @db.Text
  price             Float
  image             Json
  category          String
  subCategory       String
  sizes             Json
  colors            Json      @default("[]")
  colorImages       Json      @default("[]")
  variants          Json      @default("[]")
  bestseller        Boolean   @default(false)
  newInStore        Boolean   @default(false)
  showInNavigation  Boolean   @default(false)
  isUnisex          Boolean   @default(false)
  isSpecialOffer    Boolean   @default(false)
  offerTag          String?   @default("")
  offerEndDate      DateTime?
  discount          Float     @default(0)
  costPrice         Float     @default(0)
  stockQuantity     Int       @default(0)
  lowStockThreshold Int       @default(5)
  published         Boolean   @default(true)
  date              BigInt
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  locationDiscounts LocationProductDiscount[]
  comboBundleProducts ComboBundleProduct[] @relation("ComboBundleProductProduct")
  collaborationLink CollaborationProduct?
  collaborationSales CollaborationSale[]
  manufacturerProductionRequests ManufacturerProductionRequest[]
  manufacturerProductionCostLayers ManufacturerInventoryCostLayer[]
  inventorySkus InventorySku[]
  deliveryChargeNegotiations DistributorDeliveryChargeNegotiation[]

  @@index([published])
  @@index([category])
  @@index([bestseller])
  @@index([deletedAt])
}

model ComboBundle {
  id                  String    @id @default(uuid())
  categoryId          String
  name                String
  slug                String    @unique
  description         String?   @db.Text
  status              String    @default("ACTIVE") // ACTIVE | INACTIVE
  color               String?   @default("")
  image               String?   @db.Text
  bannerImage         String?   @db.Text
  calculatedPrice     Float     @default(0)
  sellingPrice        Float     @default(0)
  discountPercentage  Float     @default(0)
  manualPriceOverride Boolean   @default(false)
  priceReviewRequired Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  category            Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products            ComboBundleProduct[]

  @@index([status])
  @@index([slug])
  @@index([categoryId, status])
}

model ComboBundleProduct {
  id            String     @id @default(uuid())
  comboBundleId String
  productId     String
  selectedColor String?    @db.VarChar(100)
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  comboBundle ComboBundle @relation(fields: [comboBundleId], references: [id], onDelete: Cascade)
  product     Product     @relation("ComboBundleProductProduct", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([comboBundleId, productId])
  @@index([comboBundleId])
  @@index([productId])
}

model Order {
  id                          String              @id @default(uuid())
  userId                      String
  items                       Json
  amount                      Float
  deliveryFee                 Float               @default(0)
  address                     Json
  status                      String              @default("Order Placed")
  paymentMethod               String
  payment                     Boolean             @default(false)
  date                        BigInt
  loyaltyDiscount             Float?              @default(0)
  rewardApplied               Json?
  specialOrder                Boolean             @default(false)
  specialOrderReason          String?             @db.Text
  specialOrderManufacturerIds Json?               @default("[]")
  // Fulfillment tracking
  fulfillmentStatus           String              @default("PENDING_ASSIGNMENT")
  // PENDING_ASSIGNMENT | ASSIGNED | ACCEPTED | MANUFACTURING | QUALITY_CHECK | PACKED | READY_FOR_PICKUP | PICKED_UP | IN_TRANSIT | DELIVERED | FAILED
  assignmentId                String?
  deliveryJobId               String?
  orderType                   String              @default("ONLINE_STORE") // ONLINE_STORE | DIRECT_MANUFACTURER | DIRECT_DISTRIBUTOR
  directOrderType             String?             @default("") // HUB_VISIT | PHONE_ORDER
  manufacturerId              String? // Fulfilled directly by manufacturer
  distributorId               String? // Created and fulfilled directly by distributor hub
  assignedGiftId              String?
  assignedGiftInventoryId     String?
  assignedDistributorGiftInventoryId String?
  giftStatus                  String              @default("NONE") // NONE | PENDING_PACKING | RESERVED | DELIVERED | RETURNED | LOST
  locationDiscountManufacturerId String?
  locationDiscountProvince    String?             @db.VarChar(120)
  locationDiscountDistrict    String?             @db.VarChar(120)
  locationPricingSnapshot     Json?
  directNotes                 String?             @db.Text
  cancelledAt                 DateTime?
  cancellationReason          String?             @db.Text
  cancelledByUserId           String?
  marketingCardRequired       Boolean             @default(true)
  deliveryOrder               DeliveryOrder?
  distributorReview           DistributorReview?
  letterDeliveries            LetterDelivery[]    @relation("OrderLetterDelivery")
  marketingCardOrder          MarketingCardOrder?
  exchangeRequests            OrderExchangeRequest[]
  collaborationSales          CollaborationSale[]
  manufacturerCostAllocations ManufacturerInventoryCostAllocation[]
  assignedGift                GiftCatalog?        @relation("GiftCatalogOrder", fields: [assignedGiftId], references: [id], onDelete: SetNull)
  assignedGiftInventory       ManufacturerGiftInventory? @relation("GiftInventoryOrders", fields: [assignedGiftInventoryId], references: [id], onDelete: SetNull)
  assignedDistributorGiftInventory DistributorGiftInventory? @relation("DistributorGiftInventoryOrders", fields: [assignedDistributorGiftInventoryId], references: [id], onDelete: SetNull)
  distributor                 Distributor?         @relation("DistributorDirectOrders", fields: [distributorId], references: [id], onDelete: SetNull)

  @@index([fulfillmentStatus])
  @@index([userId])
  @@index([orderType])
  @@index([manufacturerId])
  @@index([distributorId])
  @@index([date])
  @@index([status])
  @@index([payment])
}

model DistributorReview {
  id            String      @id @default(uuid())
  orderId       String      @unique
  userId        String
  distributorId String
  rating        Int
  comment       String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([distributorId, createdAt])
  @@index([userId, createdAt])
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  subCategories SubCategory[]
  comboBundles  ComboBundle[]
}

model SubCategory {
