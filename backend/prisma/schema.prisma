  status                String    @default("DRAFT") // DRAFT, FILED, PAID
  filedDate             DateTime?
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model AccountPayable {
  id                String    @id @default(uuid())
  title             String
  payeeName         String
  category          String    @default("OPERATING_EXPENSE") // SUPPLIER_INVOICE, OPERATING_EXPENSE, ASSET_PURCHASE, PARTNER_DISTRIBUTION, TAX_DUE, LOAN_NOTE, OTHER
  referenceType     String?   @default("MANUAL") // INBOUND_SHIPMENT, FIXED_ASSET, PROFIT_DISTRIBUTION, TAX_FILING, EXPENSE, MANUAL, CUSTOMER_REFUND
  referenceId       String?   @default("")
  totalAmount       Float
  paidAmount        Float     @default(0)
  remainingBalance  Float
  dueDate           DateTime?
  invoiceNumber     String?   @default("")
  status            String    @default("UNPAID") // UNPAID, PARTIALLY_PAID, SETTLED, CANCELLED
  priority          String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  notes             String?   @db.Text
  settlementHistory Json      @default("[]") // [{ id, date, amount, fromAccountId, accountName, transactionId, notes }]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([category])
}

model AccountReceivable {
  id                String    @id @default(uuid())
  title             String
  payerName         String
  category          String    @default("CUSTOMER_RECEIVABLE") // CUSTOMER_RECEIVABLE, SUPPLIER_DEBIT_REFUND, TAX_REFUND_CREDIT, OTHER
  referenceType     String?   @default("MANUAL") // CUSTOMER_ORDER, SUPPLIER_RETURN, TAX_CREDIT, MANUAL
  referenceId       String?   @default("")
  totalAmount       Float
  receivedAmount    Float     @default(0)
  remainingBalance  Float
  dueDate           DateTime?
  invoiceNumber     String?   @default("")
  status            String    @default("UNPAID") // UNPAID, PARTIALLY_RECEIVED, SETTLED, CANCELLED
  notes             String?   @db.Text
  collectionHistory Json      @default("[]") // [{ id, date, amount, toAccountId, accountName, transactionId, notes }]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([category])
}

model Account {
  id              String        @id @default(uuid())
  accountCode     String        @unique
  accountName     String
  accountType     String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  normalBalance   String // DEBIT, CREDIT
  parentAccountId String?
  parentAccount   Account?      @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  subAccounts     Account[]     @relation("AccountHierarchy")
  description     String?       @db.Text
  isSystemAccount Boolean       @default(false)
  isActive        Boolean       @default(true)
  currentBalance  Decimal       @default(0) @db.Decimal(20, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  journalLines    JournalLine[]
  mappings        AccountingAccountMapping[]
  treasuryAccounts FinancialAccount[] @relation("FinancialAccountGLAccount")

  @@index([accountType])
  @@index([parentAccountId])
}

model FiscalYear {
  id        String             @id @default(uuid())
  name      String             @unique // e.g. "2082/2083" or "2026/2027"
  startDate DateTime
  endDate   DateTime
  status    String             @default("OPEN") // OPEN, CLOSED
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  periods   AccountingPeriod[]
}

model AccountingPeriod {
  id           String     @id @default(uuid())
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  periodName   String // e.g. "2026-09"
  startDate    DateTime
  endDate      DateTime
  status       String     @default("OPEN") // OPEN, CLOSED
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([fiscalYearId, periodName])
}

model JournalEntry {
  id                 String        @id @default(uuid())
  journalNumber      String        @unique // e.g. "JE-2026-00001"
  transactionDate    DateTime      @default(now())
  fiscalYearId       String?
  accountingPeriodId String?
  sourceType         String // SALES_INVOICE, CUSTOMER_PAYMENT, PURCHASE_BILL, SUPPLIER_PAYMENT, SALES_RETURN, SUPPLIER_RETURN, EXPENSE_PAYMENT, ASSET_PURCHASE, ASSET_DEPRECIATION, LOAN_DISBURSEMENT, LOAN_REPAYMENT, CAPITAL_INJECTION, SHARE_BUYBACK, PROFIT_DISTRIBUTION, MANUAL_JOURNAL, PERIOD_CLOSING
  sourceId           String?
  idempotencyKey     String?       @unique // Unique index to prevent duplicate posting
  referenceNumber    String?       @default("")
  description        String        @db.Text
  status             String        @default("POSTED") // DRAFT, POSTED, REVERSED, VOID
  reversedEntryId    String?
  reversalReason     String?       @db.Text
  accountingEventId  String?       @unique
  accountingEvent    AccountingEvent? @relation(fields: [accountingEventId], references: [id], onDelete: Restrict)
  totalDebit         Decimal       @default(0) @db.Decimal(20, 2)
  totalCredit        Decimal       @default(0) @db.Decimal(20, 2)
  createdBy          String?       @default("system")
  postedAt           DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  lines              JournalLine[]

  @@index([transactionDate])
  @@index([sourceType, sourceId])
  @@index([status])
}

model JournalSequence {
  fiscalYear Int      @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  accountingPartyId String?
  accountingParty AccountingParty? @relation(fields: [accountingPartyId], references: [id], onDelete: Restrict)
  debit          Decimal      @default(0) @db.Decimal(20, 2)
  credit         Decimal      @default(0) @db.Decimal(20, 2)
  description    String?      @db.Text
  customerId     String?
  customerName   String?      @default("")
  supplierId     String?
  supplierName   String?      @default("")
  productId      String?
  assetId        String?
  costCenter     String?      @default("")
  createdAt      DateTime     @default(now())

  @@index([journalEntryId])
  @@index([accountId])
  @@index([customerId])
  @@index([supplierId])
  @@index([accountingPartyId, createdAt])
}

model AccountingParty {
  id             String               @id @default(uuid())
  partyType      String               @db.VarChar(40) // CUSTOMER | MANUFACTURER | MARKETING_PARTNER | CARRIER | VENDOR | PAYMENT_PROVIDER | OTHER
  sourceEntityId String               @db.VarChar(191)
  legalName      String?              @db.VarChar(255)
  displayName    String               @db.VarChar(255)
  currency       String               @default("NPR") @db.VarChar(3)
  status         String               @default("ACTIVE") @db.VarChar(24)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  journalLines   JournalLine[]
  documents      AccountingDocument[]

  @@unique([partyType, sourceEntityId])
  @@index([partyType, status])
  @@index([displayName])
}

model AccountingAccountMapping {
  id         String   @id @default(uuid())
  mappingKey String   @unique @db.VarChar(96)
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([accountId])
}

model AccountingEvent {
  id             String        @id @default(uuid())
  idempotencyKey String        @unique @db.VarChar(191)
  sourceType     String        @db.VarChar(64)
  sourceId       String        @db.VarChar(191)
  sourceVersion  Int           @default(1)
  eventType      String        @db.VarChar(64)
  effectiveAt    DateTime
  status         String        @default("PENDING") @db.VarChar(24) // PENDING | PROCESSING | POSTED | FAILED | BLOCKED
  payload        Json
  payloadHash    String        @db.Char(64)
  attemptCount   Int           @default(0)
  lastError      String?       @db.Text
  processedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  journalEntry   JournalEntry?

  @@index([status, createdAt])
  @@index([sourceType, sourceId])
  @@index([effectiveAt])
}

model AccountingDocument {
  id              String                 @id @default(uuid())
  documentType    String                 @db.VarChar(32) // INVOICE | BILL | CREDIT_NOTE | DEBIT_NOTE
  documentNumber  String                 @unique @db.VarChar(64)
  partyId         String
  party           AccountingParty        @relation(fields: [partyId], references: [id], onDelete: Restrict)
  side            String                 @db.VarChar(16) // RECEIVABLE | PAYABLE
  sourceType      String                 @db.VarChar(64)
  sourceId        String                 @db.VarChar(191)
  issueDate       DateTime               @default(now())
  dueDate         DateTime?
  currency        String                 @default("NPR") @db.VarChar(3)
  originalAmount  Decimal                @db.Decimal(20, 2)
  allocatedAmount Decimal                @default(0) @db.Decimal(20, 2)
  remainingAmount Decimal                @db.Decimal(20, 2)
  status          String                 @default("OPEN") @db.VarChar(24) // OPEN | PARTIALLY_PAID | PAID | CANCELLED
  notes           String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  allocations     AccountingAllocation[]

  @@index([partyId, side, status])
  @@index([sourceType, sourceId])
  @@index([dueDate])
}

model AccountingAllocation {
  id             String             @id @default(uuid())
  documentId     String
  document       AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  journalEntryId String?
  amount         Decimal            @db.Decimal(20, 2)
  allocatedAt    DateTime           @default(now())
  notes          String?            @db.Text

  @@index([documentId, allocatedAt])
  @@index([journalEntryId])
}

// ============================================================
// MANUFACTURER & DELIVERY PARTNER DOMAIN
// ============================================================

model Manufacturer {
  id                       String                    @id @default(uuid())
  accountId                String?                   @unique
  account                  AuthAccount?              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                     String
  email                    String                    @unique
  password                 String?                   @default("") // bcrypt hashed
  phone                    String
  city                     String // e.g. "Kathmandu", "Pokhara", "Biratnagar"
  ncmPickupBranch          String?                   @default("") // Assigned NCM pickup branch for this manufacturer; used for ready-for-pickup submissions
  pickupBranchStatus       String?                   @default("UNVERIFIED") // UNVERIFIED | VERIFIED | REJECTED
  pickupBranchVerifiedAt   DateTime?
  pickupAddress            String?                   @db.Text
  pickupContactName        String?                   @default("")
  pickupContactPhone       String?                   @default("")
  pickupWindow             String?                   @default("")
  returnInstructions       String?                   @db.Text
  address                  String?                   @db.Text
  qualityRating            Float                     @default(5.0) // Dynamic 1.0–5.0 calculated from customer product reviews
  ratingCount              Int                       @default(0) // Total customer reviews applied
  isActive                 Boolean                   @default(true)
  isAvailable              Boolean                   @default(true) // manufacturer can toggle
  proposedCommissionRate   Float? // Current commission proposal under negotiation
  agreedCommissionRate     Float? // Final agreed commission % once both parties accept
  commissionStatus         String                    @default("PENDING") // PENDING | APPROVED | REJECTED
  commissionLastProposedBy String?                   @default("ADMIN") // ADMIN | MANUFACTURER | null
  commissionFinalizedAt    DateTime?
  commissionLockUntil      DateTime? // Prevents changes for one month after final approval
  commissionHistory        Json?                     @default("[]") // admin-only audit trail of finalized rates
  commissionNote           String?                   @db.Text
  adminCommissionFeedback  String?                   @db.Text
  // Contract fields
  contractStatus           String                    @default("ACTIVE") // ACTIVE | SUSPENDED | TERMINATED
  distributorApplicationStatus String @default("NONE") // NONE | REQUESTED | APPROVED | REJECTED
  contractDocUrl           String?                   @db.Text // uploaded PDF URL (Cloudinary)
  contractStartDate        DateTime?
  contractExpiryDate       DateTime?
  agreementNotes           String?                   @db.Text
  // Performance counters (updated by system)
  totalOrdersFulfilled     Int                       @default(0)
  onTimeCount              Int                       @default(0)
  defectCount              Int                       @default(0)
  rejectionCount           Int                       @default(0)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  inventory                ManufacturerInventory[]
  giftInventory            ManufacturerGiftInventory[]
  giftMovements            GiftMovementLog[]
  locations                ManufacturerLocation[]
  assignments              OrderAssignment[]
  exchangeRequests         OrderExchangeRequest[]
  marketingCardAssignments MarketingCardAssignment[]
  marketingCards           MarketingCard[]           @relation("MarketingCardManufacturer")
  marketingCardOrders      MarketingCardOrder[]
  productionRequests       ManufacturerProductionRequest[]
  productionCostLayers     ManufacturerInventoryCostLayer[]
  settlementRequests           ManufacturerSettlementRequest[]
  stockLocations               InventoryLocation[]              @relation("ManufacturerStockLocations")
  stockTransfers           StockTransfer[]

  @@index([city])
  @@index([isActive, isAvailable])
}

model Distributor {
  id          String       @id @default(uuid())
  accountId   String?      @unique
  account     AuthAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  name        String
  phone       String?      @db.VarChar(40)
  address     String?      @db.Text
  city        String?      @db.VarChar(120)
  province    String?      @db.VarChar(120)
  district    String?      @db.VarChar(120)
  qualityRating Float      @default(0)
  ratingCount   Int        @default(0)
  street      String?      @db.VarChar(191)
  landmark    String?      @db.VarChar(191)
  status      String       @default("PENDING_APPROVAL") // PENDING_APPROVAL | ACTIVE | SUSPENDED | REJECTED
  isActive    Boolean      @default(false)
  ncmPickupBranch          String?                   @default("")
  pickupBranchStatus       String?                   @default("UNVERIFIED") // UNVERIFIED | VERIFIED | REJECTED
  pickupBranchVerifiedAt   DateTime?
  pickupAddress            String?                   @db.Text
  pickupContactName        String?                   @default("")
  pickupContactPhone       String?                   @default("")
  pickupWindow             String?                   @default("")
  returnInstructions       String?                   @db.Text
  contractStartDate        DateTime?
  contractExpiryDate       DateTime?
  appliedAt   DateTime     @default(now())
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  stockLocations       InventoryLocation[] @relation("DistributorStockLocations")
  destinationTransfers StockTransfer[]     @relation("TransferDestinationDistributor")
  locations DistributorLocation[]
  assignments OrderAssignment[]
  deliveryChargeNegotiations DistributorDeliveryChargeNegotiation[]
  settlementRequests DistributorSettlementRequest[]
  inventoryDiscrepancies InventoryDiscrepancy[]
  marketingCards         MarketingCard[]             @relation("MarketingCardDistributor")
  marketingCardAssignments MarketingCardAssignment[]
  directOrders           Order[]                     @relation("DistributorDirectOrders")
  giftInventory          DistributorGiftInventory[]
  giftMovements           DistributorGiftMovementLog[]
  marketingCardOrders    MarketingCardOrder[]
  reviews                DistributorReview[]

  @@index([status, isActive])
}

model DistributorLocation {
  id            String   @id @default(uuid())
  distributorId String
  province      String   @db.VarChar(120)
  district      String   @db.VarChar(120)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([distributorId, province, district])
  @@index([province, district, isActive])
  @@index([distributorId, isActive])
}

model DistributorDeliveryChargeNegotiation {
  id                  String   @id @default(uuid())
  distributorId       String
  productId           String?
  deliveryCharge      Decimal  @db.Decimal(20, 2)
  returnCharge        Decimal  @db.Decimal(20, 2)
  commissionRate      Decimal  @default(0) @db.Decimal(20, 2)
  bonusRate           Decimal  @default(0) @db.Decimal(20, 2)
  incentiveRate       Decimal  @default(0) @db.Decimal(20, 2)
  vatRate             Decimal  @default(13) @db.Decimal(5, 2)
  vatInclusive        Boolean  @default(false)
  status              String   @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  proposedByRole      String   @db.VarChar(32) // ADMIN | DISTRIBUTOR
  proposedByAccountId String?
  reviewedByAccountId String?
  reviewedAt          DateTime?
  effectiveFrom       DateTime?
  effectiveUntil      DateTime?
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  distributor         Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([distributorId, status, effectiveFrom])
  @@index([productId, status])
}

model DistributorSettlementRequest {
  id                  String   @id @default(uuid())
  distributorId       String
  amount              Decimal  @db.Decimal(20, 2)
  grossEarnings       Decimal  @default(0) @db.Decimal(20, 2)
  incentives          Decimal  @default(0) @db.Decimal(20, 2)
  discountsApplied    Decimal  @default(0) @db.Decimal(20, 2)
  chargesApplied      Decimal  @default(0) @db.Decimal(20, 2)
  vatAmount           Decimal  @default(0) @db.Decimal(20, 2)
  netPayable          Decimal  @default(0) @db.Decimal(20, 2)
  status              String   @default("PENDING") // PENDING | SETTLED | REJECTED
  notes               String?  @db.Text
  adminNotes          String?  @db.Text
  requestedBy         String?
  reviewedBy          String?
  financialAccountId  String?
  idempotencyKey      String?  @unique @db.VarChar(191)
  requestedAt         DateTime @default(now())
  settledAt           DateTime?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  distributor         Distributor @relation(fields: [distributorId], references: [id], onDelete: Restrict)

  @@index([distributorId, status, requestedAt])
  @@index([status])
}

model InventorySku {
  id        String   @id @default(uuid())
  productId String
  size      String   @db.VarChar(120)
  color     String   @db.VarChar(120)
  sizeKey   String   @db.VarChar(120)
  colorKey  String   @db.VarChar(120)
  skuCode   String?  @unique @db.VarChar(191)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product       Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  balances      InventoryBalance[]
  movements     InventoryLedgerEntry[]
  transferLines StockTransferLine[]
  costLayers    ManufacturerInventoryCostLayer[]
  discrepancies InventoryDiscrepancy[]

  @@unique([productId, sizeKey, colorKey])
  @@index([productId, isActive])
}

model InventoryLocation {
  id             String   @id @default(uuid())
  locationKey    String   @unique @db.VarChar(191)
  name           String   @db.VarChar(191)
  kind           String   // FACTORY | DISTRIBUTOR | IN_TRANSIT | QUARANTINE | DAMAGED | LOST
  inventoryOwner String   @default("PLATFORM") @db.VarChar(32)
  manufacturerId String?
  distributorId  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer      Manufacturer?          @relation("ManufacturerStockLocations", fields: [manufacturerId], references: [id], onDelete: Restrict)
  distributor       Distributor?            @relation("DistributorStockLocations", fields: [distributorId], references: [id], onDelete: Restrict)
  balances          InventoryBalance[]
  sourceMovements   InventoryLedgerEntry[]  @relation("InventoryMovementSource")
  targetMovements   InventoryLedgerEntry[]  @relation("InventoryMovementTarget")
  sourceTransfers   StockTransfer[]          @relation("TransferSourceLocation")
  destinationTransfers StockTransfer[]       @relation("TransferDestinationLocation")
  discrepancies     InventoryDiscrepancy[]

  @@index([kind, isActive])
  @@index([manufacturerId, kind])
  @@index([distributorId, kind])
}

model InventoryBalance {
  id                String          @id @default(uuid())
  locationId        String
  inventorySkuId    String
  quantityOnHand    Int             @default(0)
  reservedQuantity  Int             @default(0)
  updatedAt         DateTime        @updatedAt
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  inventorySku      InventorySku   @relation(fields: [inventorySkuId], references: [id], onDelete: Restrict)

  @@unique([locationId, inventorySkuId])
  @@index([inventorySkuId])
}

model InventoryLedgerEntry {
  id                       String            @id @default(uuid())
  inventorySkuId           String
  sourceLocationId         String?
  destinationLocationId    String?
  quantity                 Int
  movementType             String // OPENING_BALANCE | PRODUCTION_RECEIPT | TRANSFER_DISPATCH | TRANSFER_RECEIPT | FULFILLMENT | RETURN | DAMAGE | LOSS | ADJUSTMENT
  inventoryOwner           String            @default("PLATFORM") @db.VarChar(32)
  referenceType            String?           @db.VarChar(64)
  referenceId              String?           @db.VarChar(191)
  productionCostLayerId    String?
  idempotencyKey           String            @unique @db.VarChar(191)
  actorId                  String?
  actorRole                String?           @db.VarChar(64)
  reason                   String?           @db.Text
  createdAt                DateTime          @default(now())
  inventorySku             InventorySku      @relation(fields: [inventorySkuId], references: [id], onDelete: Restrict)
  sourceLocation           InventoryLocation? @relation("InventoryMovementSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation      InventoryLocation? @relation("InventoryMovementTarget", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  productionCostLayer      ManufacturerInventoryCostLayer? @relation(fields: [productionCostLayerId], references: [id], onDelete: Restrict)

  @@index([inventorySkuId, createdAt])
  @@index([sourceLocationId, createdAt])
  @@index([destinationLocationId, createdAt])
  @@index([referenceType, referenceId])
}

model StockTransfer {
  id                       String           @id @default(uuid())
  manufacturerId           String
  distributorId            String
  sourceLocationId         String
  destinationLocationId    String
  status                   String           @default("PENDING_ADMIN_APPROVAL") // PENDING_ADMIN_APPROVAL | APPROVED | REJECTED | IN_TRANSIT | PARTIALLY_RECEIVED | RECEIVED | DISCREPANCY | CANCELLED
  requestedByAccountId     String?
  requestedAt              DateTime         @default(now())
  reviewedByAccountId      String?
  reviewedAt               DateTime?
  adminNote                String?          @db.Text
  availabilityPassed       Boolean          @default(false)
  qualityPassed            Boolean          @default(false)
  colorPassed              Boolean          @default(false)
  sizePassed               Boolean          @default(false)
  packagingPassed          Boolean          @default(false)
  preparedByAccountId      String?
  preparedAt               DateTime?
  dispatchedAt             DateTime?
  completedAt              DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  manufacturer             Manufacturer     @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  distributor              Distributor      @relation("TransferDestinationDistributor", fields: [distributorId], references: [id], onDelete: Restrict)
  sourceLocation           InventoryLocation @relation("TransferSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation      InventoryLocation @relation("TransferDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  lines                    StockTransferLine[]
  shipments                StockTransferShipment[]
  discrepancies            InventoryDiscrepancy[]

  @@index([manufacturerId, status, requestedAt])
  @@index([distributorId, status, requestedAt])
  @@index([status, requestedAt])
}

model StockTransferLine {
  id                String       @id @default(uuid())
  stockTransferId   String
  inventorySkuId    String
  requestedQuantity Int
  approvedQuantity  Int?
  dispatchedQuantity Int        @default(0)
  reservedShipmentQuantity Int  @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  stockTransfer     StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  inventorySku      InventorySku @relation(fields: [inventorySkuId], references: [id], onDelete: Restrict)
  shipmentLines     StockTransferShipmentLine[]

  @@unique([stockTransferId, inventorySkuId])
  @@index([inventorySkuId])
}

model StockTransferShipment {
  id                   String       @id @default(uuid())
  stockTransferId      String
  status               String       @default("PREPARING") // PREPARING | BOOKING_PENDING | BOOKING_UNKNOWN | BOOKING_FAILED | BOOKED | DISPATCHED | PARTIALLY_RECEIVED | DELIVERED | DISCREPANCY | LOST | CANCELLED
  bookingMode          String       @default("MANUAL") // MANUAL | NCM | SELF_STORE
  bookingIdempotencyKey String?     @unique @db.VarChar(191)
  bookingRequestHash   String?      @db.VarChar(64)
  deliveryPartner      String?      @db.VarChar(191)
  trackingNumber       String?      @db.VarChar(191)
  externalReference    String?      @db.VarChar(191)
  freightCharge        Decimal?     @db.Decimal(20, 2)
  freightSettlementStatus String    @default("PENDING_ADMIN_SETTLEMENT") @db.VarChar(64)
  bookedAt             DateTime?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  stockTransfer        StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Restrict)
  lines                StockTransferShipmentLine[]
  receipts             StockTransferReceipt[]
  discrepancies        InventoryDiscrepancy[]

  @@index([stockTransferId, status])
  @@index([trackingNumber])
}

model StockTransferShipmentLine {
  id                    String                 @id @default(uuid())
  shipmentId            String
  stockTransferLineId   String
  quantity              Int
  uncostedQuantity       Int                    @default(0)
  createdAt             DateTime               @default(now())
  shipment              StockTransferShipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  stockTransferLine     StockTransferLine      @relation(fields: [stockTransferLineId], references: [id], onDelete: Restrict)
  receiptLines          StockTransferReceiptLine[]
  costLayerAllocations  StockTransferShipmentLineCostLayer[]

  @@unique([shipmentId, stockTransferLineId])
  @@index([stockTransferLineId])
}

model StockTransferShipmentLineCostLayer {
  id                  String                       @id @default(uuid())
  shipmentLineId      String
  costLayerId         String
  quantity            Int
  status              String                       @default("RESERVED") // RESERVED | DISPATCHED | RELEASED
  createdAt           DateTime                     @default(now())
  shipmentLine        StockTransferShipmentLine    @relation(fields: [shipmentLineId], references: [id], onDelete: Restrict)
  costLayer           ManufacturerInventoryCostLayer @relation(fields: [costLayerId], references: [id], onDelete: Restrict)

  @@unique([shipmentLineId, costLayerId])
  @@index([costLayerId, status])
}

model StockTransferReceipt {
  id            String                @id @default(uuid())
  shipmentId    String
  idempotencyKey String?              @unique @db.VarChar(191)
  requestHash   String?               @db.VarChar(64)
  status        String                @default("CONFIRMED") // CONFIRMED | DISPUTED
  receivedBy    String?
  receivedAt    DateTime              @default(now())
  notes         String?               @db.Text
  createdAt     DateTime              @default(now())
  shipment      StockTransferShipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  lines         StockTransferReceiptLine[]
  discrepancies InventoryDiscrepancy[]

  @@index([shipmentId, receivedAt])
}

model StockTransferReceiptLine {
  id                       String                    @id @default(uuid())
  receiptId                String
  shipmentLineId           String
  goodQuantity             Int                       @default(0)
  damagedQuantity          Int                       @default(0)
  missingQuantity          Int                       @default(0)
  damageType               String?                   @db.VarChar(120)
  evidence                 Json?
  note                     String?                   @db.Text
  receipt                  StockTransferReceipt      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  shipmentLine             StockTransferShipmentLine @relation(fields: [shipmentLineId], references: [id], onDelete: Restrict)

  @@unique([receiptId, shipmentLineId])
  @@index([shipmentLineId])
}

model InventoryDiscrepancy {
  id                             String                 @id @default(uuid())
  stockTransferId                String?
  shipmentId                     String?
  receiptId                      String?
  distributorId                  String?
  inventoryLocationId            String?
  inventorySkuId                 String
  discrepancyType                String // TRANSIT_LOSS | MISSING | STITCH_DAMAGE | DELIVERY_DAMAGE | OTHER_DAMAGE | SHORT_RECEIPT | COUNT_ADJUSTMENT
  custodyStage                   String?                @db.VarChar(64)
  quantity                       Int
  status                         String                 @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | REJECTED
  reportedBy                     String?
  reportedByRole                 String?                @db.VarChar(64)
  evidence                       Json?
  details                        String?                @db.Text
  financialResponsibleParty      String                 @default("PLATFORM") @db.VarChar(32)
  idempotencyKey                String?                @unique @db.VarChar(191)
  responsiblePartyRole           String?                @db.VarChar(64)
  responsiblePartyId             String?
  platformLossAmount             Decimal?               @db.Decimal(20, 2)
  reviewedBy                     String?
  resolution                     String?                @db.Text
  resolvedAt                     DateTime?
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  stockTransfer                  StockTransfer?         @relation(fields: [stockTransferId], references: [id], onDelete: Restrict)
  shipment                       StockTransferShipment? @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  receipt                        StockTransferReceipt?  @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  distributor                    Distributor?           @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  inventoryLocation              InventoryLocation?     @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  inventorySku                   InventorySku           @relation(fields: [inventorySkuId], references: [id], onDelete: Restrict)

  @@index([stockTransferId, status, createdAt])
  @@index([distributorId, status, createdAt])
  @@index([inventoryLocationId, status])
  @@index([shipmentId, status])
  @@index([receiptId])
  @@index([inventorySkuId, discrepancyType])
}

// ============================================================
// MARKETING CARD DOMAIN
// ============================================================

model MarketingPartner {
  id           String                       @id @default(uuid())
  accountId    String?                      @unique
  account      AuthAccount?                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  code         String                       @unique @db.VarChar(32)
  name         String
  description  String?                      @db.Text
  status       String                       @default("ACTIVE") // PENDING | ACTIVE | INACTIVE
  email        String?                      @unique @db.VarChar(255) // Portal login email
  passwordHash String?                      @db.VarChar(255) // bcrypt hash for portal login
  contactPhone String?                      @db.VarChar(32)
  website      String?                      @db.VarChar(255)
  address      String?                      @db.Text
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  campaigns    MarketingCampaign[]
  cards        MarketingCard[]
  assignedCards MarketingCard[]               @relation("MarketingCardAssignedPartner")
  settlements  MarketingPartnerSettlement[]
  collaborationProducts CollaborationProduct[]
  collaborationSales CollaborationSale[]
  collaborationFeeInvoices CollaborationFeeInvoice[]

  @@index([status])
  @@index([email])
}

model MarketingCampaign {
  id                 String                       @id @default(uuid())
  marketingPartnerId String?
  isOwnStore         Boolean                      @default(false)
  maxScansPerCustomer Int                          @default(1)
  name               String
  description        String?                      @db.Text
  targetScopeType    String                       @default("NATIONWIDE") // NATIONWIDE | PROVINCE | DISTRICT
  targetProvince     String?                      @db.VarChar(120)
  targetDistrict     String?                      @db.VarChar(120)
  benefitConfig      Json                         @default("[]")
  requestedQuantity  Int                          @default(0)
  generatedQuantity  Int                          @default(0)
  status             String                       @default("ACTIVE") // DRAFT | ACTIVE | PAUSED | EXPIRED | CANCELLED
  startsAt           DateTime?
  endsAt             DateTime?
  cardExpiresAt      DateTime? // Cards can be redeemed until this date (must be >= endsAt + 1 day)
  targetCategories   Json                         @default("[]") // Array of clothing category names/IDs e.g. ["Women Dresses", "Hoodies"]
  minOrderValue      Float                        @default(0) // Cart total threshold for smart card allocation
  cpaRate            Float                        @default(0) // Platform commission or CPA fee per verified redemption
  adMediaType        String?                      @default("NONE") // NONE | IMAGE | VIDEO
  adMediaUrl         String?                      @db.Text
  adHeadline         String?                      @db.VarChar(255)
  adDescription      String?                      @db.Text
  adExternalLink     String?                      @db.VarChar(255)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  marketingPartner   MarketingPartner?            @relation(fields: [marketingPartnerId], references: [id], onDelete: Restrict)
  batches            MarketingCardBatch[]
  cards              MarketingCard[]
  benefits           MarketingBenefit[]
  settlements        MarketingPartnerSettlement[]

  @@index([marketingPartnerId, status])
  @@index([targetScopeType, targetProvince, targetDistrict])
}

model MarketingCardBatch {
  id         String            @id @default(uuid())
  campaignId String
  batchCode  String            @unique @db.VarChar(64)
  quantity   Int
  status     String            @default("GENERATED") // GENERATED | ASSIGNED | COMPLETED | CANCELLED
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  cards      MarketingCard[]

  @@index([campaignId, status])
}

model MarketingCard {
  id                     String                       @id @default(uuid())
  cardCode               String                       @unique @db.VarChar(64)
  qrTokenHash            String                       @unique @db.Char(64)
  partnerId              String?
  assignedPartnerId      String?
  assignedOrganization   String?                      @db.VarChar(191)
  isPublic               Boolean                      @default(false)
  campaignId             String
  batchId                String
  assignedManufacturerId String?
  assignedDistributorId  String?
  hasBenefit             Boolean                      @default(false)
  benefitId              String?
  exchangeLockRequestId  String?                      @db.VarChar(191)
  physicalStatus         String                       @default("GENERATED") // GENERATED | ASSIGNED | RECEIVED | AVAILABLE | RESERVED | ATTACHED | CANCELLED
  assignedAt             DateTime?
  receivedAt             DateTime?
  reservedAt             DateTime?
  attachedAt             DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  partner                MarketingPartner?            @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  assignedPartner        MarketingPartner?            @relation("MarketingCardAssignedPartner", fields: [assignedPartnerId], references: [id], onDelete: SetNull)
  campaign               MarketingCampaign            @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  batch                  MarketingCardBatch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  benefit                MarketingBenefit?            @relation(fields: [benefitId], references: [id], onDelete: SetNull)
  assignedManufacturer   Manufacturer?                @relation("MarketingCardManufacturer", fields: [assignedManufacturerId], references: [id], onDelete: SetNull)
  assignedDistributor    Distributor?                 @relation("MarketingCardDistributor", fields: [assignedDistributorId], references: [id], onDelete: SetNull)
  assignments            MarketingCardAssignment[]
  orderLink              MarketingCardOrder?
  exchangeRequests       OrderExchangeRequest[]
  customerLinks          MarketingCardCustomer[]
  events                 MarketingCardEvent[]
  benefitRedemptions     MarketingBenefitRedemption[]

  @@index([campaignId, physicalStatus])
  @@index([assignedManufacturerId, physicalStatus])
  @@index([assignedDistributorId, physicalStatus])
  @@index([batchId, physicalStatus])
  @@index([benefitId])
  @@index([exchangeLockRequestId])
  @@index([assignedPartnerId, physicalStatus])
  @@index([assignedOrganization, physicalStatus])
  @@index([campaignId, isPublic, physicalStatus])
}

model MarketingCardAssignment {
  id             String                @id @default(uuid())
  cardId         String
  manufacturerId String?
  distributorId  String?
  assignedBy     String
  assignedAt     DateTime              @default(now())
  status         String                @default("ASSIGNED") // ASSIGNED | RECEIVED | DISPUTED | CANCELLED
  confirmedAt    DateTime?
  notes          String?               @db.Text
  card           MarketingCard         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  manufacturer   Manufacturer?         @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  distributor    Distributor?          @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  receipt        MarketingCardReceipt?

  @@index([manufacturerId, status])
  @@index([distributorId, status])
  @@index([cardId, assignedAt])
}

model MarketingCardReceipt {
  id           String                  @id @default(uuid())
  assignmentId String                  @unique
  confirmedBy  String
  confirmedAt  DateTime                @default(now())
  notes        String?                 @db.Text
  assignment   MarketingCardAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model MarketingCardOrder {
  id             String        @id @default(uuid())
  cardId         String        @unique
  orderId        String        @unique
  manufacturerId String?
  distributorId  String?
  attachedAt     DateTime      @default(now())
  card           MarketingCard @relation(fields: [cardId], references: [id], onDelete: Restrict)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  distributor    Distributor?  @relation(fields: [distributorId], references: [id], onDelete: Restrict)

  @@index([manufacturerId, attachedAt])
  @@index([distributorId, attachedAt])
}

model MarketingCardCustomer {
  id                   String        @id @default(uuid())
  cardId               String
  customerId           String
  linkedAt             DateTime      @default(now())
  scannedAt            DateTime      @default(now())
  assignedOrganization String?       @db.VarChar(191)
  scanWeekIndex        Int           @default(0)
  activatedAt          DateTime?
  status               String        @default("LINKED") // LINKED | ACTIVE | CANCELLED
  inStoreOtp           String?       @db.VarChar(6)
  otpExpiresAt         DateTime?
  lastRedeemedLocation String?       @db.VarChar(255)
  card                 MarketingCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  customer             User          @relation("MarketingCardCustomerUser", fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([cardId])
  @@index([customerId, status])
  @@index([customerId, scanWeekIndex])
  @@index([customerId, scanWeekIndex, assignedOrganization], map: "MCC_customer_week_org_idx")
}

model MarketingBenefit {
  id               String                       @id @default(uuid())
  campaignId       String
  name             String
  description      String?                      @db.Text
  benefitType      String                       @default("CUSTOM")
  value            Float                        @default(0)
  percentage       Float                        @default(0) // Percentage of customer cards (e.g. 10 for 10% of customers)
  quantity         Int                          @default(0) // Fixed number of cards allocated for this benefit
  assignedQuantity Int                          @default(0) // Number of cards assigned this benefit during generation
  terms            String?                      @db.Text
  startsAt         DateTime?
  expiresAt        DateTime?
  status           String                       @default("ACTIVE")
  campaign         MarketingCampaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  cards            MarketingCard[]
  redemptions      MarketingBenefitRedemption[]

  @@index([campaignId, status])
}

model MarketingBenefitRedemption {
  id         String           @id @default(uuid())
  cardId     String
  benefitId  String
  customerId String
  status     String           @default("REDEEMED") // REDEEMED | CANCELLED
  claimedAt  DateTime?
  redeemedAt DateTime?        @default(now())
  card       MarketingCard    @relation(fields: [cardId], references: [id], onDelete: Restrict)
  benefit    MarketingBenefit @relation(fields: [benefitId], references: [id], onDelete: Restrict)
  customer   User             @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([cardId, benefitId])
  @@index([customerId, status])
  @@index([benefitId, redeemedAt])
}

model MarketingCardEvent {
  id          String        @id @default(uuid())
  cardId      String
  eventType   String
  actorId     String?
  actorRole   String?
  fromStatus  String?
  toStatus    String?
  referenceId String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  card        MarketingCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([eventType, createdAt])
}

model MarketingPartnerSettlement {
  id               String             @id @default(uuid())
  partnerId        String
  campaignId       String?
  periodStart      DateTime
  periodEnd        DateTime
  totalRedemptions Int                @default(0)
  cpaRate          Float              @default(0)
  totalAmount      Float              @default(0)
  paymentStatus    String             @default("UNPAID") // UNPAID | PAID | WAIVED
  paidAt           DateTime?
  referenceNote    String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  partner          MarketingPartner   @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  campaign         MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([partnerId, paymentStatus])
  @@index([createdAt])
}

model CollaborationProduct {
  id                   String   @id @default(uuid())
  productId            String   @unique
  partnerId            String
  listingStatus        String   @default("DRAFT") // DRAFT | ACTIVE | PAUSED | ENDED
  activeTermsVersion   Int?
  pendingTermsVersion  Int?
  publishedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  product              Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  partner              MarketingPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  termsVersions        CollaborationTermsVersion[]
  sales                CollaborationSale[]

  @@index([partnerId, listingStatus])
  @@index([listingStatus, publishedAt])
}

model CollaborationTermsVersion {
  id                   String   @id @default(uuid())
  collaborationProductId String
  version              Int
  proposedByRole       String   @db.VarChar(24) // ADMIN | MARKETING_PARTNER
  proposedById         String
  status               String   @default("PENDING_PARTNER") // PENDING_ADMIN | PENDING_PARTNER | ACCEPTED | REJECTED | SUPERSEDED
  fixedFeePerUnit      Decimal  @default(0) @db.Decimal(20, 2)
  retailPrice          Decimal  @db.Decimal(20, 2)
  discountPercentage   Decimal  @default(0) @db.Decimal(5, 2)
  vatTreatment         String   @default("VAT_EXCLUSIVE") @db.VarChar(24) // VAT_EXCLUSIVE | VAT_INCLUSIVE | EXEMPT
  notes                String?  @db.Text
  respondedByRole      String?  @db.VarChar(24)
  respondedById        String?
  proposedAt           DateTime @default(now())
  respondedAt          DateTime?
  createdAt            DateTime @default(now())
  collaborationProduct CollaborationProduct @relation(fields: [collaborationProductId], references: [id], onDelete: Cascade)
  sales                CollaborationSale[]

  @@unique([collaborationProductId, version])
  @@index([collaborationProductId, status])
}

model CollaborationSale {
  id                     String   @id @default(uuid())
  orderId                String
  orderItemIndex         Int
  productId              String
  collaborationProductId String
  partnerId              String
  termsVersion           Int
  quantity               Int
  quantityReturned       Int      @default(0)
  quantityInvoiced       Int      @default(0)
  quantityCredited       Int      @default(0)
  size                   String   @default("") @db.VarChar(64)
  color                  String   @default("") @db.VarChar(100)
  unitSellingPrice       Decimal  @db.Decimal(20, 2)
  unitDiscount           Decimal  @default(0) @db.Decimal(20, 2)
  partnerFeePerUnit      Decimal  @db.Decimal(20, 2)
  vatTreatment           String   @default("VAT_EXCLUSIVE") @db.VarChar(24)
  status                 String   @default("PENDING_DELIVERY") // PENDING_DELIVERY | ACCRUED | PARTIALLY_REVERSED | INVOICED | REVERSED
  deliveredAt            DateTime?
  accruedAt              DateTime?
  lastReturnAt           DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  order                  Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product                Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  collaborationProduct   CollaborationProduct @relation(fields: [collaborationProductId], references: [id], onDelete: Restrict)
  partner                MarketingPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  terms                  CollaborationTermsVersion @relation(fields: [collaborationProductId, termsVersion], references: [collaborationProductId, version], onDelete: Restrict)
  invoiceLines           CollaborationFeeInvoiceLine[]

  @@unique([orderId, orderItemIndex])
  @@index([partnerId, status, deliveredAt])
  @@index([collaborationProductId, status])
}

model CollaborationFeeInvoice {
  id                String   @id @default(uuid())
  invoiceNumber     String   @unique @db.VarChar(64)
  partnerId         String
  periodStart       DateTime
  periodEnd         DateTime
  totalUnits        Int      @default(0)
  netAmount         Decimal  @default(0) @db.Decimal(20, 2)
  vatAmount         Decimal  @default(0) @db.Decimal(20, 2)
  totalAmount       Decimal  @default(0) @db.Decimal(20, 2)
  accountingDocumentId String? @unique
  status            String   @default("ISSUED") // ISSUED | PAID | VOID
  issuedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  partner           MarketingPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  lines             CollaborationFeeInvoiceLine[]

  @@unique([partnerId, periodStart])
  @@index([partnerId, issuedAt])
}

model CollaborationFeeInvoiceLine {
  id             String   @id @default(uuid())
  invoiceId      String
  saleId         String
  entryType      String   @default("FEE") // FEE | RETURN_CREDIT
  quantity       Int
  unitFee        Decimal  @db.Decimal(20, 2)
  netAmount      Decimal  @db.Decimal(20, 2)
  vatAmount      Decimal  @db.Decimal(20, 2)
  totalAmount    Decimal  @db.Decimal(20, 2)
  createdAt      DateTime @default(now())
  invoice        CollaborationFeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sale           CollaborationSale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, saleId, entryType])
  @@index([saleId, createdAt])
}

model NcmBranch {
  id           String   @id @default(uuid())
  ncmPk        Int      @unique
  code         String?  @db.VarChar(40)
  name         String   @unique @db.VarChar(120)
  branchType   String?  @db.VarChar(80)
  geocode      String?  @db.VarChar(120)
  address      String?  @db.Text
  phone        String?  @db.VarChar(40)
  phone2       String?  @db.VarChar(80)
  provinceName String?  @db.VarChar(120)
  districtName String?  @db.VarChar(120)
  coveredAreas Json
  isActive     Boolean  @default(true)
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, districtName])
  @@index([isActive, provinceName])
}

model ManufacturerLocation {
  id             String       @id @default(uuid())
  manufacturerId String
  province       String       @db.VarChar(120)
  district       String       @db.VarChar(120)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@unique([manufacturerId, province, district])
  @@index([province, district, isActive])
  @@index([manufacturerId, isActive])
}

model LocationProductDiscount {
  id                 String   @id @default(uuid())
  productId          String
  province           String   @db.VarChar(120)
  district           String   @db.VarChar(120)
  discountPercentage Decimal  @default(0) @db.Decimal(5, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, province, district])
  @@index([province, district, isActive])
  @@index([productId, isActive])
}

// Per-manufacturer inventory for each product
model ManufacturerInventory {
  id                String   @id @default(uuid())
  manufacturerId    String
  productId         String
  productName       String // denormalized for display speed
  quantity          Int      @default(0) // actual physical stock (sum of variants)
  reservedQty       Int      @default(0) // reserved for accepted/in-progress orders
  variantsStock     Json     @default("[]") // [{ size, color, quantity, reservedQty }]
  proposedCostPrice Float? // manufacturer proposed supply cost price
  agreedCostPrice   Float? // admin accepted agreed supply cost price
  priceStatus       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  priceNote         String?  @db.Text
  adminFeedback     String?  @db.Text
  lastUpdated       DateTime @updatedAt

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@unique([manufacturerId, productId])
  @@index([productId])
  @@index([manufacturerId])
}

model ManufacturerProductionRequest {
  id                         String   @id @default(uuid())
  manufacturerId             String
  productId                  String
  productName                String
  status                     String   @default("PENDING_REVIEW") // PENDING_REVIEW | PENDING_PRE_CHECK | PRE_CHECK_FAILED | PRE_CHECK_PASSED | POST_CHECK_FAILED | REJECTED | APPROVED | IN_PRODUCTION | COMPLETED | CANCELLED
  proposedUnitCogs            Decimal? @db.Decimal(20, 2)
  minimumOrderQuantity        Int
  proposedDeliveryCost        Decimal  @default(0) @db.Decimal(20, 2) // Packaging/other overhead per delivered unit; excluded from production COGS
  approvedUnitCogs            Decimal? @db.Decimal(20, 2)
  approvedMinimumOrderQuantity Int?
  approvedDeliveryCost       Decimal? @db.Decimal(20, 2)
  fabricType                 String?  @db.VarChar(120)
  gsm                        Decimal? @db.Decimal(8, 2)
  targetCompletionDate       DateTime?
  batchPlan                  Json?
  preProductionChecklist     Json?
  preProductionCheckedAt     DateTime?
  postProductionChecklist    Json?
  postProductionCheckedAt    DateTime?
  manufacturerNote           String?  @db.Text
  adminNote                  String?  @db.Text
  reviewedBy                 String?
  requestedBy                String?
  requestedAt                DateTime @default(now())
  reviewedAt                 DateTime?
  startedAt                  DateTime?
  completedAt                DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  manufacturer               Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  product                    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  lines                      ManufacturerProductionRequestLine[]
  costLayers                 ManufacturerInventoryCostLayer[]

  @@index([manufacturerId, status, requestedAt])
  @@index([productId, status])
}

model ManufacturerProductionRequestLine {
  id              String   @id @default(uuid())
  requestId       String
  size            String   @db.VarChar(120)
  color           String   @db.VarChar(120)
  quantity        Int
  actualQuantity  Int?
  damagedQuantity Int      @default(0)
  request         ManufacturerProductionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, size, color])
  @@index([requestId])
}

model ManufacturerSettlementRequest {
  id                  String   @id @default(uuid())
  manufacturerId      String
  requestType         String   @default("PRODUCTION") // PRODUCTION | LOGISTICS
  amount              Decimal  @db.Decimal(20, 2)
  status              String   @default("PENDING") // PENDING | PAID | REJECTED
  notes               String?  @db.Text
  requestedBy         String?
  reviewedBy          String?
  financialAccountId  String?
  idempotencyKey      String?  @unique @db.VarChar(191)
  requestedAt         DateTime @default(now())
  paidAt              DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  manufacturer        Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)

  @@index([manufacturerId, status, requestedAt])
  @@index([requestType, status])
}

model ManufacturerInventoryCostLayer {
  id                String   @id @default(uuid())
  productionRequestId String
  manufacturerId    String
  productId         String
  inventorySkuId    String?
  size              String   @db.VarChar(120)
  color             String   @db.VarChar(120)
  producedQuantity  Int
  availableQuantity Int
  reservedQuantity  Int      @default(0)
  consumedQuantity  Int      @default(0)
  unitCogs          Decimal  @db.Decimal(20, 2)
  unitDeliveryCost  Decimal  @default(0) @db.Decimal(20, 2)
  createdAt         DateTime @default(now())
  productionRequest ManufacturerProductionRequest @relation(fields: [productionRequestId], references: [id], onDelete: Restrict)
  manufacturer      Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  product           Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventorySku      InventorySku? @relation(fields: [inventorySkuId], references: [id], onDelete: Restrict)
  allocations       ManufacturerInventoryCostAllocation[]
  transferAllocations StockTransferShipmentLineCostLayer[]
  ledgerEntries    InventoryLedgerEntry[]

  @@index([manufacturerId, productId, size, color, createdAt])
  @@unique([productionRequestId, size, color])
}

model ManufacturerInventoryCostAllocation {
  id          String   @id @default(uuid())
  orderId     String
  orderItemIndex Int
  costLayerId String
  quantity    Int
  returnedQuantity Int @default(0)
  state       String   @default("RESERVED") // RESERVED | CONSUMED | RELEASED | RETURNED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  costLayer   ManufacturerInventoryCostLayer @relation(fields: [costLayerId], references: [id], onDelete: Restrict)

  @@unique([orderId, orderItemIndex, costLayerId])
  @@index([costLayerId, state])
  @@index([orderId, state])
}

model ManufacturerInventoryMovement {
  id             String   @id @default(uuid())
  manufacturerId String
  productId      String
  productName    String
  variantLabel   String
  previousQty    Int
  newQty         Int
  changeQty      Int
  movementType   String
  reason         String
  note           String?  @db.Text
  actorId        String?
  actorRole      String   @default("MANUFACTURER")
  source         String   @default("MANUFACTURER_PORTAL")
  createdAt      DateTime @default(now())

  @@index([manufacturerId, productId, createdAt], map: "ManInvMove_manufacturer_product_created_idx")
  @@index([productId, createdAt], map: "ManInvMove_product_created_idx")
}

// Order assignment from Allocation Engine to a Manufacturer
model OrderAssignment {
  id              String    @id @default(uuid())
  orderId         String    @unique
  manufacturerId  String?
  distributorId   String?
  deliveryType    String    @default("SELF_DELIVERY") // SELF_DELIVERY | NCM
  status          String    @default("PENDING_ACCEPTANCE")
  // PENDING_ACCEPTANCE | ACCEPTED | MANUFACTURING | QUALITY_CHECK | PACKED | READY_FOR_PICKUP | PICKED_UP | DISPATCHED | ON_THE_WAY | DELIVERED | RETURNED | REJECTED
  assignedAt      DateTime  @default(now())
  acceptedAt      DateTime?
  dispatchedAt    DateTime?
  onTheWayAt      DateTime?
  manufacturingAt DateTime?
  qualityCheckAt  DateTime?
  packedAt        DateTime?
  readyAt         DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  returnedAt      DateTime?
  notes           String?   @db.Text
  rejectionReason String?

  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id])
  distributor Distributor? @relation(fields: [distributorId], references: [id])

  @@index([orderId])
  @@index([manufacturerId])
  @@index([distributorId])
  @@index([status])
}

// One carrier package and NCM submission for an order.
model DeliveryOrder {
  id                     String          @id @default(uuid())
  orderId                String          @unique
  assignmentId           String?
  manufacturerId         String
  state                  String          @default("READY_TO_DELIVER")
  deliveryType           String          @default("Door2Door")
  packageVersion         Int             @default(1)
  packageWeight          Float           @default(1)
  packageDescription     String?         @db.Text
  originBranchName       String
  destinationBranchName  String
  itemAmount             Float           @default(0)
  customerDeliveryCharge Float           @default(0)
  ncmDeliveryCharge      Float?
  codAmount              Float           @default(0)
  ncmOrderId             Int?            @unique
  vendorReference        String          @unique
  ncmStatus              String?
  ncmPaymentStatus       String?
  lastSyncedAt           DateTime?
  nextSyncAt             DateTime?
  syncFailureCount       Int             @default(0)
  lastSyncError          String?         @db.Text
  readyAt                DateTime        @default(now())
  ncmCreatedAt           DateTime?
  pickedUpAt             DateTime?
  deliveredAt            DateTime?
  returnedAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  order                  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events                 DeliveryEvent[]

  @@index([state])
  @@index([manufacturerId, state])
  @@index([nextSyncAt])
}

model DeliveryEvent {
  id              String        @id @default(uuid())
  deliveryOrderId String
  orderId         String
  source          String
  eventType       String
  fromState       String?
  toState         String?
  ncmStatus       String?
  payloadJson     Json?
  actorId         String?
  occurredAt      DateTime      @default(now())
  idempotencyKey  String        @unique
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  @@index([deliveryOrderId, occurredAt])
  @@index([orderId, occurredAt])
}

model DeliveryComment {
  id              String    @id @default(uuid())
  deliveryOrderId String?
  ncmOrderId      Int
  comments        String    @db.Text
  addedBy         String?
  addedAt         DateTime?
  payloadJson     Json
  eventKey        String    @unique
  createdAt       DateTime  @default(now())

  @@index([deliveryOrderId, createdAt])
  @@index([ncmOrderId, createdAt])
}

model NcmRequestAttempt {
  id              String    @id @default(uuid())
  deliveryOrderId String
  operation       String
  idempotencyKey  String    @unique
  attemptNumber   Int
  requestUrl      String
  requestJson     Json?
  responseJson    Json?
  httpStatus      Int?
  result          String
  errorCode       String?
  errorMessage    String?   @db.Text
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  nextRetryAt     DateTime?

  @@index([deliveryOrderId, operation])
  @@index([result, nextRetryAt])
}

model NcmWebhookEvent {
  id               String    @id @default(uuid())
  eventKey         String    @unique
  event            String?
  orderId          String?
  orderIds         Json?
  status           String?
  timestamp        DateTime?
  payloadJson      Json
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  processingStatus String    @default("RECEIVED")
  processingError  String?   @db.Text

  @@index([orderId])
  @@index([processingStatus, receivedAt])
}

model DeliveryReturn {
  id                   String    @id @default(uuid())
  deliveryOrderId      String    @unique
  orderId              String
  manufacturerId       String
  state                String    @default("RETURN_REQUESTED")
  returnReason         String
  ncmReturnComment     String?   @db.Text
  ncmReturnRequestedAt DateTime?
  trackingReference    String?
  receivedAt           DateTime?
  inspectedAt          DateTime?
  inspectionResult     String?
  restockDecision      String?
  notes                String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([manufacturerId, state])
  @@index([orderId])
}

model DeliveryFinancialSettlement {
  id                  String    @id @default(uuid())
  deliveryOrderId     String    @unique
  ncmOrderId          Int?
  codExpected         Float     @default(0)
  codCollected        Float     @default(0)
  deliveryFeeExpected Float     @default(0)
  deliveryFeeActual   Float     @default(0)
  otherAdjustments    Float     @default(0)
  manufacturerPayable Float     @default(0)
  platformReceivable  Float     @default(0)
  ncmTicketId         Int?
  settlementState     String    @default("PENDING")
  settledAt           DateTime?
  journalEntryId      String?
  varianceReason      String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([settlementState])
  @@index([ncmOrderId])
}

// Operating, Marketing & Overhead Expenses Model
model OperatingExpense {
  id                 String   @id @default(uuid())
  title              String
  category           String // MARKETING | RENT | ELECTRICITY | SALARIES | UTILITIES | MISCELLANEOUS | MAINTENANCE | PRINTING | CUSTOM
  amount             Float // Total expense amount
  isVatBill          Boolean  @default(false)
  vatAmount          Float    @default(0) // Input VAT embedded if 13% VAT bill provided
  date               DateTime @default(now())
  paymentMethod      String   @default("CASH") // CASH | BANK_TRANSFER | QR_PAYMENT | CREDIT
  paymentStatus      String   @default("PAID") // PAID | PAYABLE
  financialAccountId String?
  payableId          String?
  vendorName         String? // Vendor / landlord / service provider / employee
  invoiceNumber      String? // Bill reference
  notes              String?  @db.Text
  createdBy          String   @default("ADMIN")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category])
  @@index([date])
  @@index([isVatBill])
  @@index([paymentStatus])
  @@index([financialAccountId])
  @@index([payableId])
}

// Direct & Miscellaneous Incomes Model
model DirectIncome {
  id                 String   @id @default(uuid())
  title              String
  category           String // DIRECT_SALES | SCRAP_SALES | CUSTOM_WORK | PRINTING_SERVICE | COMMISSION | OTHER
  amount             Float
  date               DateTime @default(now())
  toAccountId        String
  payerName          String?
  invoiceNumber      String?
  notes              String?  @db.Text
  createdBy          String   @default("ADMIN")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category])
  @@index([date])
  @@index([toAccountId])
}

// Dynamic Custom Income & Expense Categories
model FinancialCategory {
  id          String   @id @default(uuid())
  type        String // EXPENSE | INCOME
  name        String
  code        String   @unique
  description String?  @db.Text
  color       String?  @default("#6366f1")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, isActive])
}

// Nepal Location Mapping (4-character unique code map for provinces and 77 districts)
model LocationMapping {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(4) // e.g., '0KTM', 'PRBT', 'REST', 'RWST', 'BAGM', 'NATW'
  name      String   @db.VarChar(120)
  type      String   @db.VarChar(32) // 'NATIONWIDE' | 'PROVINCE' | 'DISTRICT'
  province  String?  @db.VarChar(120) // Parent province for district
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([name])
  @@index([province])
}

// ============================================================
// SETTLEMENT REVERSION AUDIT MODEL
// Tracks every admin-initiated reversal of a settled payable,
// receivable, or manufacturer net payout.
// ============================================================
model SettlementReversion {
  id                  String   @id @default(uuid())
  // What was reversed
  reversionType       String   @db.VarChar(48) // PAYABLE | RECEIVABLE | MANUFACTURER_PAYMENT | NCM_COD
  originalRecordId    String   @db.VarChar(191) // AccountPayable.id | AccountReceivable.id | CashTransaction.id
  cashTransactionId   String?  @db.VarChar(191) // The original CashTransaction being reversed
  reversalTransactionId String? @db.VarChar(191) // New CashTransaction created for the reversal (INFLOW for payable reversal, OUTFLOW for receivable reversal)
  // Settlement snapshot at time of reversal
  originalAmount      Float    // Amount that was paid/collected in the original settlement
  offsetAmount        Float    @default(0) // Bilateral netting offset that was applied (manufacturer only)
  partyName           String?  @db.VarChar(255) // Manufacturer / payee name
  accountId           String?  @db.VarChar(191) // FinancialAccount used in original settlement
  accountName         String?  @db.VarChar(255)
  // Post-reversion state
  priorStatus         String   @db.VarChar(32)  // Status before reversion (SETTLED | PARTIALLY_PAID | etc.)
  restoredStatus      String   @db.VarChar(32)  // Status after reversion (UNPAID | PARTIALLY_PAID)
  priorPaidAmount     Float    @default(0)
  priorRemainingBalance Float  @default(0)
  // Admin audit
  revertedByAdminId   String?  @db.VarChar(191)
  revertedByEmail     String?  @db.VarChar(255)
  revertReason        String   @db.Text
  revertedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([reversionType, originalRecordId])
  @@index([revertedAt])
  @@index([revertedByAdminId])
}
