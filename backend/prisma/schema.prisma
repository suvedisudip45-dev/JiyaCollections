generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(uuid())
  firstName String? @default("")
  lastName  String? @default("")
  phone     String? @default("")
  name      String
  email     String  @unique
  password  String
  cartData  Json    @default("{}")
  addresses Json    @default("[]")
}

model Product {
  id                String    @id @default(uuid())
  name              String
  description       String    @db.Text
  price             Float
  image             Json
  category          String
  subCategory       String
  sizes             Json
  colors            Json      @default("[]")
  variants          Json      @default("[]")
  bestseller        Boolean   @default(false)
  newInStore        Boolean   @default(false)
  isSpecialOffer    Boolean   @default(false)
  offerTag          String?   @default("")
  offerEndDate      DateTime?
  discount          Float     @default(0)
  costPrice         Float     @default(0)
  stockQuantity     Int       @default(0)
  lowStockThreshold Int       @default(5)
  published         Boolean   @default(true)
  date              BigInt

  @@index([published])
  @@index([category])
  @@index([bestseller])
}

model Order {
  id                String         @id @default(uuid())
  userId            String
  items             Json
  amount            Float
  deliveryFee       Float          @default(0)
  address           Json
  status            String         @default("Order Placed")
  paymentMethod     String
  payment           Boolean        @default(false)
  date              BigInt
  loyaltyDiscount   Float?         @default(0)
  rewardApplied     Json?
  // Fulfillment tracking
  fulfillmentStatus String         @default("PENDING_ASSIGNMENT")
  // PENDING_ASSIGNMENT | ASSIGNED | ACCEPTED | MANUFACTURING | QUALITY_CHECK | PACKED | READY_FOR_PICKUP | PICKED_UP | IN_TRANSIT | DELIVERED | FAILED
  assignmentId      String?
  deliveryJobId     String?
  orderType         String         @default("ONLINE_STORE") // ONLINE_STORE | DIRECT_MANUFACTURER
  directOrderType   String?        @default("") // HUB_VISIT | PHONE_ORDER
  manufacturerId    String? // Fulfilled directly by manufacturer
  directNotes       String?        @db.Text
  deliveryOrder     DeliveryOrder?

  @@index([fulfillmentStatus])
  @@index([userId])
  @@index([orderType])
  @@index([manufacturerId])
  @@index([date])
  @@index([status])
  @@index([payment])
}

model Category {
  id   String @id @default(uuid())
  name String @unique
}

model SubCategory {
  id   String @id @default(uuid())
  name String @unique
}

model Color {
  id   String @id @default(uuid())
  name String @unique
}

model Review {
  id        String  @id @default(uuid())
  productId String
  userId    String
  userName  String
  userEmail String
  rating    Int
  title     String? @default("")
  comment   String  @db.Text
  likes     Json    @default("[]")
  dislikes  Json    @default("[]")
  verified  Boolean @default(true)
  date      BigInt
}

model ShippingConfig {
  id                   String   @id @default("default")
  sameDistrictFee      Float    @default(50)
  differentDistrictFee Float    @default(120)
  freeShippingMin      Float?   @default(0)
  updatedAt            DateTime @updatedAt
}

model CustomerLevel {
  id                String   @id @default(uuid())
  levelNumber       Int      @unique
  name              String
  badgeIcon         String   @default("🥉")
  color             String   @default("#CD7F32")
  minSpend          Float    @default(0)
  minOrders         Int      @default(0)
  rewardType        String   @default("CUSTOM")
  rewardValue       Float?   @default(0)
  rewardTitle       String   @default("Welcome Reward")
  rewardDescription String?  @db.Text
  rewardOrderLimit  Int      @default(3)
  freeShipping      Boolean  @default(false)
  discountAmount    Float    @default(0)
  giftAmount        Float    @default(0)
  giftDescription   String?  @default("")
  letterIncluded    Boolean  @default(false)
  customPerk        String?  @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CustomerLetterImage {
  id        String   @id @default(uuid())
  userId    String
  userEmail String?
  imageUrl  String
  title     String?  @default("Letter / Handwritten Note")
  notes     String?  @db.Text
  orderId   String?
  createdAt DateTime @default(now())
}

model SpecialOffer {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?  @default("Exclusive festive deals and limited-time discounts")
  badgeText   String   @default("🎉 FESTIVE OFFER")
  bannerImage String?  @default("")
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  discount    Float?   @default(0)
  productIds  Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StockLog {
  id           String   @id @default(uuid())
  productId    String
  productName  String
  variantLabel String?  @default("")
  previousQty  Int
  newQty       Int
  changeQty    Int
  reason       String
  note         String?  @db.Text
  orderId      String?
  source       String?  @default("admin")
  createdAt    DateTime @default(now())
}

model InboundShipment {
  id                String   @id @default(uuid())
  batchNumber       String   @unique
  supplierName      String   @default("") // Whom purchased from
  invoiceNumber     String?  @default("")
  carrier           String   @default("Local Freight")
  shipmentDate      DateTime
  totalFreightCost  Float    @default(0)
  customsOrTaxes    Float    @default(0)
  totalItemsCost    Float    @default(0)
  totalLandedCost   Float    @default(0)
  paidFromAccountId String?
  paidAmount        Float    @default(0)
  payableAmount     Float    @default(0)
  payableId         String?
  paymentStatus     String   @default("PAID") // PAID, PARTIALLY_PAID, PAYABLE_UNPAID
  notes             String?  @db.Text
  items             Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MonthlyExpense {
  id                    String   @id @default(uuid())
  yearMonth             String   @unique
  marketingSpend        Float    @default(0)
  officeRent            Float    @default(0)
  utilities             Float    @default(0)
  salaries              Float    @default(0)
  softwareTools         Float    @default(0)
  packagingCostPerUnit  Float    @default(20)
  miscExpenses          Float    @default(0)
  projectedMonthlyUnits Int      @default(300)
  notes                 String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // bcrypt-hashed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinancialAccount {
  id             String            @id @default(uuid())
  accountName    String            @unique
  accountType    String            @default("BANK") // CASH, BANK, WALLET, ESCROW
  accountNumber  String?           @default("")
  bankName       String?           @default("")
  currentBalance Float             @default(0)
  currency       String            @default("NPR")
  isDefault      Boolean           @default(false)
  status         String            @default("ACTIVE")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  outflows       CashTransaction[] @relation("FromAccount")
  inflows        CashTransaction[] @relation("ToAccount")
}

model CashTransaction {
  id            String            @id @default(uuid())
  date          DateTime          @default(now())
  amount        Float
  type          String // INFLOW, OUTFLOW, TRANSFER
  fromAccountId String?
  toAccountId   String?
  category      String // SALES, SUPPLIER_PAYMENT, EXPENSE, CAPITAL_INJECTION, DRAWINGS, LOAN_DISBURSEMENT, LOAN_REPAYMENT, ASSET_PURCHASE, REFUND, INTERNAL_TRANSFER
  partyName     String?           @default("") // Whom paid to / Whom received from
  invoiceNumber String?           @default("")
  referenceId   String?           @default("")
  description   String?           @db.Text
  receiptUrl    String?           @default("")
  fromAccount   FinancialAccount? @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccount     FinancialAccount? @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([date])
  @@index([category])
  @@index([type])
}

model FixedAsset {
  id                      String    @id @default(uuid())
  assetName               String
  assetTag                String    @unique
  category                String // COMPUTERS_IT, FURNITURE_FIXTURES, VEHICLES, MACHINERY_EQUIPMENT, LEASEHOLD_IMPROVEMENTS
  vendorName              String?   @default("") // Whom purchased from
  invoiceNumber           String?   @default("")
  purchaseDate            DateTime
  purchaseCost            Float
  salvageValue            Float     @default(0)
  usefulLifeMonths        Int       @default(60)
  depreciationMethod      String    @default("WRITTEN_DOWN_VALUE_SLAB") // STRAIGHT_LINE, WRITTEN_DOWN_VALUE_SLAB
  depreciationRate        Float     @default(25) // Annual % (e.g. 25 for IT, 20 for Vehicles)
  accumulatedDepreciation Float     @default(0)
  currentBookValue        Float
  paidFromAccountId       String?
  paidAmount              Float     @default(0)
  payableAmount           Float     @default(0)
  payableId               String?
  status                  String    @default("ACTIVE") // ACTIVE, DAMAGED, WRITTEN_OFF, SOLD, DISPOSED
  damageNotes             String?   @db.Text
  disposalDate            DateTime?
  disposalAmount          Float?    @default(0)
  scrapLossAmount         Float?    @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model PartnerEquity {
  id                         String   @id @default(uuid())
  partnerName                String
  email                      String   @unique
  phone                      String?  @default("")
  role                       String   @default("PARTNER") // FOUNDER, CO_FOUNDER, ANGEL_INVESTOR, INSTITUTIONAL_INVESTOR, PARTNER
  shareCount                 Float    @default(0) // Number of shares held
  sharePrice                 Float    @default(100) // Price per share at issuance / acquisition
  ownershipPercentage        Float // e.g. 50.0 (Strictly normalized in cap table)
  initialCapital             Float    @default(0)
  currentCapital             Float    @default(0)
  totalDrawings              Float    @default(0)
  totalDistributionsReceived Float    @default(0)
  isPrimaryPartner           Boolean  @default(false)
  investmentHistory          Json     @default("[]") // [{ date, roundName, shares, amount, type }]
  status                     String   @default("ACTIVE") // ACTIVE, INACTIVE, EXITED
  notes                      String?  @db.Text
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model CompanyValuation {
  id                 String   @id @default(uuid())
  roundName          String // e.g. "Incorporation / Founder Round", "Seed Round", "Series A"
  effectiveDate      DateTime @default(now())
  preMoneyValuation  Float    @default(0)
  investmentAmount   Float    @default(0)
  postMoneyValuation Float    @default(0)
  totalPreShares     Float    @default(0)
  newSharesIssued    Float    @default(0)
  totalPostShares    Float    @default(0)
  sharePrice         Float    @default(100)
  valuationMethod    String   @default("EQUITY_ROUND") // EQUITY_ROUND, DCF, MULTIPLE, BOOK_VALUE, MANUAL_REVALUATION
  leadInvestor       String?  @default("")
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ShareTransaction {
  id                          String   @id @default(uuid())
  transactionType             String // PRIMARY_ISSUANCE, SECONDARY_TRANSFER, SHARE_BUYBACK, FOUNDER_ALLOCATION, DILUTION_REBALANCE
  fromPartnerId               String? // null if PRIMARY_ISSUANCE or FOUNDER_ALLOCATION
  fromPartnerName             String?  @default("")
  toPartnerId                 String? // null if SHARE_BUYBACK
  toPartnerName               String?  @default("")
  shareCount                  Float
  sharePrice                  Float    @default(100)
  totalAmount                 Float    @default(0)
  equityPercentageTransferred Float    @default(0)
  depositAccountId            String? // Treasury account if money flowed into/out of company
  settlementType              String   @default("COMPANY_TREASURY") // COMPANY_TREASURY, PRIVATE_PEER_TO_PEER
  valuationRoundId            String?  @default("")
  date                        DateTime @default(now())
  notes                       String?  @db.Text
  createdAt                   DateTime @default(now())
}

model ProfitDistribution {
  id                         String   @id @default(uuid())
  periodStart                DateTime
  periodEnd                  DateTime
  fiscalYear                 String // e.g. "2082/2083"
  grossRevenue               Float    @default(0)
  netProfit                  Float    @default(0)
  retainedEarningsPercentage Float    @default(20) // % reinvested in business
  retainedAmount             Float    @default(0)
  distributableAmount        Float    @default(0)
  partnerBreakdown           Json     @default("[]") // [{ partnerId, name, percentage, amount, paymentStatus, paidDate }]
  status                     String   @default("APPROVED") // DRAFT, APPROVED, PAID
  notes                      String?  @db.Text
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model InvestorLiability {
  id                      String    @id @default(uuid())
  investorName            String
  contactPhone            String?   @default("")
  contactEmail            String?   @default("")
  type                    String // EQUITY_INVESTOR, LONG_TERM_LOAN, SHORT_TERM_BORROWING, CREDIT_LINE
  loanType                String?   @default("TERM_LOAN") // TERM_LOAN, WORKING_CAPITAL, REVOLVING_CREDIT, PROMISSORY_NOTE
  principalAmount         Float
  principalPaid           Float     @default(0)
  interestPaid            Float     @default(0)
  totalInterestPayable    Float     @default(0)
  amountRepaid            Float     @default(0) // principalPaid + interestPaid
  outstandingBalance      Float // remaining principal balance
  interestRate            Float     @default(0) // Annual % APR
  loanTermMonths          Int?      @default(12) // Duration in months
  monthlyInstallment      Float?    @default(0) // Amortized EMI amount
  equityGrantedPercentage Float?    @default(0) // If equity investor
  disbursementAccountId   String?   @default("")
  loanSchedule            Json      @default("[]") // [{ monthNumber, dueDate, emi, principalPortion, interestPortion, remainingPrincipal, status }]
  startDate               DateTime
  maturityDate            DateTime?
  status                  String    @default("ACTIVE") // ACTIVE, SETTLED, DEFAULTED
  notes                   String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model CustomerReturn {
  id                String   @id @default(uuid())
  orderId           String?
  userId            String?
  customerName      String
  customerPhone     String?  @default("")
  returnDate        DateTime @default(now())
  items             Json     @default("[]") // [{ productId, name, size, color, quantity, unitPrice, refundAmount, condition: 'RESTOCKABLE' | 'DAMAGED' }]
  totalRefundAmount Float    @default(0)
  vatRefunded       Float    @default(0) // 13% VAT portion reversed
  refundMethod      String   @default("CASH") // CASH, BANK_TRANSFER, WALLET, STORE_CREDIT
  refundStatus      String   @default("COMPLETED") // PENDING, COMPLETED, REJECTED
  inventoryAction   String   @default("RESTOCKED") // RESTOCKED, WRITTEN_OFF_DAMAGED, PARTIAL
  reason            String // e.g. "Size mismatch", "Defective/Damaged", "Customer changed mind"
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SupplierReturn {
  id               String   @id @default(uuid())
  shipmentBatchId  String?
  supplierName     String
  returnDate       DateTime @default(now())
  items            Json     @default("[]") // [{ productId, name, quantity, unitCostPrice, totalDebitCost }]
  totalDebitAmount Float    @default(0)
  vatReversal      Float    @default(0) // 13% Input VAT reversal
  settlementType   String   @default("CREDIT_NOTE_OFFSET_PAYABLE") // CASH_REFUND, CREDIT_NOTE_OFFSET_PAYABLE
  status           String   @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  reason           String
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TaxConfiguration {
  id                   String   @id @default("default")
  fiscalYear           String   @default("2082/2083")
  vatRate              Float    @default(13.0)
  corporateTaxRate     Float    @default(25.0)
  taxSlabs             Json     @default("[]")
  autoDeductAdvanceTax Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

model TaxFilingRecord {
  id                    String    @id @default(uuid())
  periodType            String // MONTHLY_VAT, ANNUAL_INCOME_TAX
  periodKey             String // e.g. "2026-09" or "FY2082-83"
  taxableSales          Float     @default(0)
  outputVat             Float     @default(0)
  taxablePurchases      Float     @default(0)
  inputVat              Float     @default(0)
  netVatPayable         Float     @default(0)
  grossRevenue          Float     @default(0)
  totalDeductions       Float     @default(0)
  depreciationDeduction Float     @default(0)
  taxableIncome         Float     @default(0)
  calculatedTax         Float     @default(0)
  taxPaid               Float     @default(0)
  status                String    @default("DRAFT") // DRAFT, FILED, PAID
  filedDate             DateTime?
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model AccountPayable {
  id                String    @id @default(uuid())
  title             String
  payeeName         String
  category          String    @default("OPERATING_EXPENSE") // SUPPLIER_INVOICE, OPERATING_EXPENSE, ASSET_PURCHASE, PARTNER_DISTRIBUTION, TAX_DUE, LOAN_NOTE, OTHER
  referenceType     String?   @default("MANUAL") // INBOUND_SHIPMENT, FIXED_ASSET, PROFIT_DISTRIBUTION, TAX_FILING, EXPENSE, MANUAL, CUSTOMER_REFUND
  referenceId       String?   @default("")
  totalAmount       Float
  paidAmount        Float     @default(0)
  remainingBalance  Float
  dueDate           DateTime?
  invoiceNumber     String?   @default("")
  status            String    @default("UNPAID") // UNPAID, PARTIALLY_PAID, SETTLED, CANCELLED
  priority          String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  notes             String?   @db.Text
  settlementHistory Json      @default("[]") // [{ id, date, amount, fromAccountId, accountName, transactionId, notes }]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([category])
}

model AccountReceivable {
  id                String    @id @default(uuid())
  title             String
  payerName         String
  category          String    @default("CUSTOMER_RECEIVABLE") // CUSTOMER_RECEIVABLE, SUPPLIER_DEBIT_REFUND, TAX_REFUND_CREDIT, OTHER
  referenceType     String?   @default("MANUAL") // CUSTOMER_ORDER, SUPPLIER_RETURN, TAX_CREDIT, MANUAL
  referenceId       String?   @default("")
  totalAmount       Float
  receivedAmount    Float     @default(0)
  remainingBalance  Float
  dueDate           DateTime?
  invoiceNumber     String?   @default("")
  status            String    @default("UNPAID") // UNPAID, PARTIALLY_RECEIVED, SETTLED, CANCELLED
  notes             String?   @db.Text
  collectionHistory Json      @default("[]") // [{ id, date, amount, toAccountId, accountName, transactionId, notes }]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([category])
}

model Account {
  id              String        @id @default(uuid())
  accountCode     String        @unique
  accountName     String
  accountType     String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  normalBalance   String // DEBIT, CREDIT
  parentAccountId String?
  parentAccount   Account?      @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  subAccounts     Account[]     @relation("AccountHierarchy")
  description     String?       @db.Text
  isSystemAccount Boolean       @default(false)
  isActive        Boolean       @default(true)
  currentBalance  Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  journalLines    JournalLine[]

  @@index([accountType])
  @@index([parentAccountId])
}

model FiscalYear {
  id        String             @id @default(uuid())
  name      String             @unique // e.g. "2082/2083" or "2026/2027"
  startDate DateTime
  endDate   DateTime
  status    String             @default("OPEN") // OPEN, CLOSED
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  periods   AccountingPeriod[]
}

model AccountingPeriod {
  id           String     @id @default(uuid())
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  periodName   String // e.g. "2026-09"
  startDate    DateTime
  endDate      DateTime
  status       String     @default("OPEN") // OPEN, CLOSED
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([fiscalYearId, periodName])
}

model JournalEntry {
  id                 String        @id @default(uuid())
  journalNumber      String        @unique // e.g. "JE-2026-00001"
  transactionDate    DateTime      @default(now())
  fiscalYearId       String?
  accountingPeriodId String?
  sourceType         String // SALES_INVOICE, CUSTOMER_PAYMENT, PURCHASE_BILL, SUPPLIER_PAYMENT, SALES_RETURN, SUPPLIER_RETURN, EXPENSE_PAYMENT, ASSET_PURCHASE, ASSET_DEPRECIATION, LOAN_DISBURSEMENT, LOAN_REPAYMENT, CAPITAL_INJECTION, SHARE_BUYBACK, PROFIT_DISTRIBUTION, MANUAL_JOURNAL, PERIOD_CLOSING
  sourceId           String?
  idempotencyKey     String?       @unique // Unique index to prevent duplicate posting
  referenceNumber    String?       @default("")
  description        String        @db.Text
  status             String        @default("POSTED") // DRAFT, POSTED, REVERSED, VOID
  reversedEntryId    String?
  reversalReason     String?       @db.Text
  totalDebit         Float         @default(0)
  totalCredit        Float         @default(0)
  createdBy          String?       @default("system")
  postedAt           DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  lines              JournalLine[]

  @@index([transactionDate])
  @@index([sourceType, sourceId])
  @@index([status])
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Float        @default(0)
  credit         Float        @default(0)
  description    String?      @db.Text
  customerId     String?
  customerName   String?      @default("")
  supplierId     String?
  supplierName   String?      @default("")
  productId      String?
  assetId        String?
  costCenter     String?      @default("")
  createdAt      DateTime     @default(now())

  @@index([journalEntryId])
  @@index([accountId])
  @@index([customerId])
  @@index([supplierId])
}

// ============================================================
// MANUFACTURER & DELIVERY PARTNER DOMAIN
// ============================================================

model Manufacturer {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  password             String // bcrypt hashed
  phone                String
  city                 String // e.g. "Kathmandu", "Pokhara", "Biratnagar"
  ncmPickupBranch      String?   @default("") // Assigned NCM pickup branch for this manufacturer; used for ready-for-pickup submissions
  pickupBranchStatus   String?   @default("UNVERIFIED") // UNVERIFIED | VERIFIED | REJECTED
  pickupBranchVerifiedAt DateTime?
  pickupAddress        String?   @db.Text
  pickupContactName    String?   @default("")
  pickupContactPhone   String?   @default("")
  pickupWindow         String?   @default("")
  returnInstructions   String?   @db.Text
  address              String?   @db.Text
  qualityRating        Float     @default(5.0) // Dynamic 1.0–5.0 calculated from customer product reviews
  ratingCount          Int       @default(0) // Total customer reviews applied
  isActive             Boolean   @default(true)
  isAvailable          Boolean   @default(true) // manufacturer can toggle
  proposedCommissionRate Float?    // Current commission proposal under negotiation
  agreedCommissionRate   Float?    // Final agreed commission % once both parties accept
  commissionStatus       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  commissionLastProposedBy String?  @default("ADMIN") // ADMIN | MANUFACTURER | null
  commissionFinalizedAt  DateTime?
  commissionLockUntil    DateTime? // Prevents changes for one month after final approval
  commissionHistory      Json?     @default("[]") // admin-only audit trail of finalized rates
  commissionNote         String?   @db.Text
  adminCommissionFeedback String? @db.Text
  // Contract fields
  contractStatus       String    @default("ACTIVE") // ACTIVE | SUSPENDED | TERMINATED
  contractDocUrl       String?   @db.Text // uploaded PDF URL (Cloudinary)
  contractStartDate    DateTime?
  contractExpiryDate   DateTime?
  agreementNotes       String?   @db.Text
  // Performance counters (updated by system)
  totalOrdersFulfilled Int       @default(0)
  onTimeCount          Int       @default(0)
  defectCount          Int       @default(0)
  rejectionCount       Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  inventory   ManufacturerInventory[]
  assignments OrderAssignment[]

  @@index([city])
  @@index([isActive, isAvailable])
}

model NcmBranch {
  id             String   @id @default(uuid())
  ncmPk          Int      @unique
  code           String?  @db.VarChar(40)
  name           String   @unique @db.VarChar(120)
  branchType     String?  @db.VarChar(80)
  geocode        String?  @db.VarChar(120)
  address        String?  @db.Text
  phone          String?  @db.VarChar(40)
  phone2         String?  @db.VarChar(80)
  provinceName   String?  @db.VarChar(120)
  districtName   String?  @db.VarChar(120)
  coveredAreas   Json
  isActive       Boolean  @default(true)
  lastSyncedAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, districtName])
  @@index([isActive, provinceName])
}

// Per-manufacturer inventory for each product
model ManufacturerInventory {
  id                String   @id @default(uuid())
  manufacturerId    String
  productId         String
  productName       String // denormalized for display speed
  quantity          Int      @default(0) // actual physical stock (sum of variants)
  reservedQty       Int      @default(0) // reserved for accepted/in-progress orders
  variantsStock     Json     @default("[]") // [{ size, color, quantity, reservedQty }]
  proposedCostPrice Float? // manufacturer proposed supply cost price
  agreedCostPrice   Float? // admin accepted agreed supply cost price
  priceStatus       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  priceNote         String?  @db.Text
  adminFeedback     String?  @db.Text
  lastUpdated       DateTime @updatedAt

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@unique([manufacturerId, productId])
  @@index([productId])
  @@index([manufacturerId])
}

// Order assignment from Allocation Engine to a Manufacturer
model OrderAssignment {
  id              String    @id @default(uuid())
  orderId         String    @unique
  manufacturerId  String
  status          String    @default("PENDING_ACCEPTANCE")
  // PENDING_ACCEPTANCE | ACCEPTED | MANUFACTURING | QUALITY_CHECK | PACKED | READY_FOR_PICKUP | PICKED_UP | REJECTED
  assignedAt      DateTime  @default(now())
  acceptedAt      DateTime?
  manufacturingAt DateTime?
  qualityCheckAt  DateTime?
  packedAt        DateTime?
  readyAt         DateTime?
  pickedUpAt      DateTime?
  notes           String?   @db.Text
  rejectionReason String?

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])

  @@index([orderId])
  @@index([manufacturerId])
  @@index([status])
}

// One carrier package and NCM submission for an order.
model DeliveryOrder {
  id                     String          @id @default(uuid())
  orderId                String          @unique
  assignmentId           String?
  manufacturerId         String
  state                  String          @default("READY_TO_DELIVER")
  deliveryType           String          @default("Door2Door")
  packageVersion         Int             @default(1)
  packageWeight          Float           @default(1)
  packageDescription     String?         @db.Text
  originBranchName       String
  destinationBranchName  String
  itemAmount             Float           @default(0)
  customerDeliveryCharge Float           @default(0)
  ncmDeliveryCharge      Float?
  codAmount              Float           @default(0)
  ncmOrderId             Int?            @unique
  vendorReference        String          @unique
  ncmStatus              String?
  ncmPaymentStatus       String?
  lastSyncedAt           DateTime?
  nextSyncAt             DateTime?
  syncFailureCount       Int             @default(0)
  lastSyncError          String?         @db.Text
  readyAt                DateTime        @default(now())
  ncmCreatedAt           DateTime?
  pickedUpAt             DateTime?
  deliveredAt            DateTime?
  returnedAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  order                  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events                 DeliveryEvent[]

  @@index([state])
  @@index([manufacturerId, state])
  @@index([nextSyncAt])
}

model DeliveryEvent {
  id              String        @id @default(uuid())
  deliveryOrderId String
  orderId         String
  source          String
  eventType       String
  fromState       String?
  toState         String?
  ncmStatus       String?
  payloadJson     Json?
  actorId         String?
  occurredAt      DateTime      @default(now())
  idempotencyKey  String        @unique
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  @@index([deliveryOrderId, occurredAt])
  @@index([orderId, occurredAt])
}

model DeliveryComment {
  id              String    @id @default(uuid())
  deliveryOrderId String?
  ncmOrderId      Int
  comments        String    @db.Text
  addedBy         String?
  addedAt         DateTime?
  payloadJson     Json
  eventKey        String    @unique
  createdAt       DateTime  @default(now())

  @@index([deliveryOrderId, createdAt])
  @@index([ncmOrderId, createdAt])
}

model NcmRequestAttempt {
  id              String    @id @default(uuid())
  deliveryOrderId String
  operation       String
  idempotencyKey  String    @unique
  attemptNumber   Int
  requestUrl      String
  requestJson     Json?
  responseJson    Json?
  httpStatus      Int?
  result          String
  errorCode       String?
  errorMessage    String?   @db.Text
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  nextRetryAt     DateTime?

  @@index([deliveryOrderId, operation])
  @@index([result, nextRetryAt])
}

model NcmWebhookEvent {
  id               String    @id @default(uuid())
  eventKey         String    @unique
  event            String?
  orderId          String?
  orderIds         Json?
  status           String?
  timestamp        DateTime?
  payloadJson      Json
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  processingStatus String    @default("RECEIVED")
  processingError  String?   @db.Text

  @@index([orderId])
  @@index([processingStatus, receivedAt])
}

model DeliveryReturn {
  id                   String    @id @default(uuid())
  deliveryOrderId      String    @unique
  orderId              String
  manufacturerId       String
  state                String    @default("RETURN_REQUESTED")
  returnReason         String
  ncmReturnComment     String?   @db.Text
  ncmReturnRequestedAt DateTime?
  trackingReference    String?
  receivedAt           DateTime?
  inspectedAt          DateTime?
  inspectionResult     String?
  restockDecision      String?
  notes                String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([manufacturerId, state])
  @@index([orderId])
}

model DeliveryFinancialSettlement {
  id                  String    @id @default(uuid())
  deliveryOrderId     String    @unique
  ncmOrderId          Int?
  codExpected         Float     @default(0)
  codCollected        Float     @default(0)
  deliveryFeeExpected Float     @default(0)
  deliveryFeeActual   Float     @default(0)
  otherAdjustments    Float     @default(0)
  manufacturerPayable Float     @default(0)
  platformReceivable  Float     @default(0)
  ncmTicketId         Int?
  settlementState     String    @default("PENDING")
  settledAt           DateTime?
  journalEntryId      String?
  varianceReason      String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([settlementState])
  @@index([ncmOrderId])
}

// Operating, Marketing & Overhead Expenses Model
model OperatingExpense {
  id            String   @id @default(uuid())
  title         String
  category      String // MARKETING | RENT | ELECTRICITY | SALARIES | UTILITIES | MISCELLANEOUS | MAINTENANCE
  amount        Float // Total expense amount
  isVatBill     Boolean  @default(false)
  vatAmount     Float    @default(0) // Input VAT embedded if 13% VAT bill provided
  date          DateTime @default(now())
  paymentMethod String   @default("CASH") // CASH | BANK_TRANSFER | QR_PAYMENT | CREDIT
  vendorName    String? // Vendor / landlord / service provider
  invoiceNumber String? // Bill reference
  notes         String?  @db.Text
  createdBy     String   @default("ADMIN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([date])
  @@index([isVatBill])
}
