# Frontend Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env — it is already in .gitignore

# ─── Backend API URL ────────────────────────────────────────
# Local dev: http://localhost:4000
# Production (Netlify): your Railway backend URL
VITE_BACKEND_URL=https://your-backend.railway.app

# ─── Encryption ─────────────────────────────────────────────
# Must match the AES_SECRET_KEY on the backend
VITE_AES_KEY=your_aes_secret_key_here
VITE_AES_IV=your_aes_iv_hex_here

# ─── Legacy request signing compatibility ─────────────────────
# Shared secret used to create the same compatibility signature as the backend
# when a Node.js client needs to interoperate with the Java filter.
# VITE_ values are public in the browser bundle and are not confidential secrets.
VITE_HMAC_SECRET=replace_with_a_shared_hmac_secret
